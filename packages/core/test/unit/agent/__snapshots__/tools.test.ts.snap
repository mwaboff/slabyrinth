// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`system prompt > is frozen per version 1`] = `"81ab34d69fe2b1c0"`;

exports[`working tool list (tools-1.11.0; published versions are pinned by hash below) > serializes deterministically (the bytes are the cache key) 1`] = `
"{"description":"Record what you and the GM have agreed in the design brief card (map type, game system, party, footprint, levels, tone, must-include, avoid, theme). Call it whenever the conversation settles or changes one of these, in the same turn. Fields the GM set by hand are kept; the result tells you which were skipped.","input_schema":{"additionalProperties":false,"properties":{"set":{"additionalProperties":false,"properties":{"avoid":{"items":{"type":"string"},"type":"array"},"footprint":{"additionalProperties":false,"properties":{"heightSq":{"type":"integer"},"preset":{"enum":["small","medium","large","custom"],"type":"string"},"widthSq":{"type":"integer"}},"required":["preset","widthSq","heightSq"],"type":"object"},"levels":{"additionalProperties":false,"properties":{"count":{"type":"integer"},"names":{"items":{"type":"string"},"type":"array"}},"required":["count","names"],"type":"object"},"mapType":{"type":"string"},"mustInclude":{"items":{"type":"string"},"type":"array"},"party":{"additionalProperties":false,"properties":{"level":{"type":"integer"},"size":{"type":"integer"},"tier":{"type":"integer"}},"type":"object"},"system":{"enum":["daggerheart","dnd5e","other"],"type":"string"},"theme":{"type":"string"},"tone":{"type":"string"}},"type":"object"}},"required":["set"],"type":"object"},"name":"update_brief"}
{"description":"Ask the GM up to 3 clarifying questions as a card with answer chips. Use at most once per turn and normally only once before the first draft; every question must state the default you will use if it is ignored. Your turn ends with this call — the answers arrive as its result together with the GM's next message. Do not repeat the questions in text.","input_schema":{"additionalProperties":false,"properties":{"questions":{"items":{"additionalProperties":false,"properties":{"default":{"type":"string"},"id":{"type":"string"},"options":{"items":{"type":"string"},"maxItems":4,"minItems":2,"type":"array"},"text":{"type":"string"}},"required":["id","text","default","options"],"type":"object"},"maxItems":3,"minItems":1,"type":"array"}},"required":["questions"],"type":"object"},"name":"ask_questions"}
{"description":"Create the map plan from scratch (or replace it wholesale with replace=true). Call this once the GM has agreed on the brief, to produce the FIRST complete draft. For any later change use edit_plan instead — never re-send the whole plan to change a part of it. The app validates the plan; if it is rejected nothing changes and the result lists every problem with hints.","input_schema":{"$defs":{"area":{"additionalProperties":false,"properties":{"arch":{"description":"bridge only: rise of the middle above the ends, tiles 0..2.","type":"number"},"broken":{"description":"bridge only: deck cells that have fallen away.","items":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"maxItems":64,"type":"array"},"condition":{"description":"Generator 5: how kept the place is (a ruined room is rubble, sparsely dressed). Omitted = read from its words, else the place around it.","enum":["intact","weathered","ramshackle","ruined"],"type":"string"},"crumble":{"description":"bridge only: 0..0.6 fraction of deck cells crumbled away; a way across always remains.","type":"number"},"encounter":{"description":"Encounter line(s) in the brief's game system.","type":"string"},"floor":{"description":"Omitted = the theme default. Generator 4, a room on a solid-base level: leave it off and the room takes a floor from its purpose in the theme's floor family, unlike its neighbours' where it can; a passage or an abandoned room keeps the default. Name a floor only to choose one (naming the theme default counts as leaving it off).","enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete","none"],"type":"string"},"floorHeight":{"description":"Tiles relative to the level, multiple of 0.25, -4..4 (dais 0.5, pit -1). Omitted = keep the height underneath (e.g. from a height op). Generator 4: a room on a solid-base level that a corridor opens into (an opening, a route ending on it, or no wall between) sits a quarter tile above it when this is omitted; 0 keeps it level.","type":"number"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"key":{"description":"Room-key label, e.g. \\"1\\" or \\"A3\\".","type":"string"},"kind":{"description":"zone = names cells only (never changes floor, height or walls). bridge = a walkable deck over a drop: open air under it, railings on the sides facing the drop, deck height = floorHeight or the floor at its ends; list it AFTER the areas it crosses.","enum":["room","corridor","cave","building","courtyard","zone","bridge"],"type":"string"},"labelAt":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"light":{"description":"Generator 5: how many lights mark the place in use, dark (none) to flooded; not the board's brightness. Omitted = read from its words, else the place around it.","enum":["dark","dim","moderate","bright","flooded"],"type":"string"},"name":{"type":"string"},"notes":{"type":"string"},"purpose":{"description":"Generator 4: set it only when the name does not say what the room is for; it wins over the name, tags and notes. Generator 5: the name also picks kinds this list lacks (shop, stable, lounge or parlour, classroom, command, ward or infirmary); leave purpose off for those.","enum":["tavern","dining","kitchen","library","study","armoury","barracks","bedroom","storeroom","shrine","crypt","prison","forge","laboratory","treasury","washroom","throne_room","ruin","passage"],"type":"string"},"railing":{"description":"bridge only: railing style on the edges facing the drop (default low_wall; ruined for a crumbling bridge).","enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"readAloud":{"description":"Boxed text read to players on entry.","type":"string"},"shape":{"$ref":"#/$defs/shape"},"span":{"description":"bridge only: arch (stone, rises to the middle, piers, parapet), flat, plank (wood, sags, rope railing), natural (rock span or fallen column). Default by floor. A bridge whose ends touch floors at different heights becomes an inclined span with steps.","enum":["arch","flat","plank","natural"],"type":"string"},"tags":{"items":{"type":"string"},"type":"array"},"theme":{"type":"string"},"wallHeight":{"description":"Tiles (1 = 5 ft), multiple of 0.25.","type":"number"},"wallStyle":{"enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber"],"type":"string"},"walls":{"enum":["auto","perimeter","none"],"type":"string"},"wealth":{"description":"Generator 5: how plain or rich its trims and contents are. Omitted = read from its words, else the place around it.","enum":["poor","modest","wealthy","lavish"],"type":"string"}},"required":["id","kind","shape"],"type":"object"},"feature":{"additionalProperties":false,"properties":{"at":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"gmOnly":{"type":"boolean"},"hint":{"description":"Required for type \\"custom\\": a plain noun that is a whole word of the game asset's name (\\"wheel\\", \\"anchor\\", \\"skull\\"); its last word must be in the name.","type":"string"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"label":{"type":"string"},"lift":{"description":"Tiles (1 = 5 ft), multiple of 0.25.","type":"number"},"notes":{"type":"string"},"rot":{"enum":[0,90,180,270],"type":"integer"},"size":{"description":"Cells [w, h]. Leave it off for a named type (the piece keeps its own footprint). For custom, the size of the thing: only an asset within about nine times its area either way is taken.","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"type":{"description":"Generator 4: clutter is the small things a room's dressing stands on its furniture (variant table, study, store, tools or shelf) and shelf_line a wall shelf plank for them (needs wall); a room dressed by default or by a preset already has both.","enum":["table","round_table","chair","bench","stool","bed","bunk_bed","wardrobe","bookshelf","desk","chest","barrel","crate","sack","shelf","counter","bar_counter","throne","rug","cauldron","anvil","forge","weapon_rack","armor_stand","cage","stocks","pillar","statue","altar","fountain","well","brazier","torch_wall","candelabra","banner_wall","painting_wall","sarcophagus","coffin","tomb","bones","rubble","web","debris","pool","lever","trap","trap_plate","chandelier","tree","dead_tree","pine_tree","bush","rock","boulder","stump","log","mushroom","flowers","tall_grass","reeds","campfire","tent","cart","wagon","fence_post","signpost","standing_stone","grave","stalagmite","stalactite","rock_formation","cave_in","crystal","giant_mushroom","root","root_large","roots_wall","vines","tree_large","candles","skull_pile","spawn_point","torch_floor","lantern","magic_fire","lava_glow","fire_pit","monolith","cave_column","statue_large","mine_cart","rails","mine_support","chains","landmark","tall_marker","formation","cluster_tall","undergrowth","ground_cover","accent_light","edge_dressing","small_detail","wall_dressing","bank_dressing","jetty","vehicle","seating","signage","cliff_face","cliff_crest","stall","goods","overhead","line_post","clutter","shelf_line","custom"],"type":"string"},"variant":{"type":"string"},"wall":{"enum":["N","E","S","W"],"type":"string"}},"required":["id","type","at"],"type":"object"},"label":{"additionalProperties":false,"properties":{"at":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"size":{"enum":["s","m","l"],"type":"string"},"text":{"type":"string"}},"required":["id","text","at"],"type":"object"},"level":{"additionalProperties":false,"properties":{"areas":{"items":{"$ref":"#/$defs/area"},"type":"array"},"base":{"oneOf":[{"additionalProperties":false,"properties":{"type":{"const":"solid"}},"required":["type"],"type":"object"},{"additionalProperties":false,"properties":{"type":{"const":"void"}},"required":["type"],"type":"object"},{"additionalProperties":false,"properties":{"layer":{"description":"under (default) = applied before the areas: paint/noise/path under are replaced wherever an area sets its floor (use under for outdoor ground and roads); a height op under sets the ground height that areas without floorHeight inherit. over = applied after the areas, on their floor (water or lava in a cave, a dais or pit inside a room).","enum":["under","over"],"type":"string"},"material":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"type":{"const":"ground"}},"required":["type","material"],"type":"object"}]},"bounds":{"additionalProperties":false,"properties":{"h":{"type":"integer"},"w":{"type":"integer"},"x":{"type":"integer"},"y":{"type":"integer"}},"required":["x","y","w","h"],"type":"object"},"condition":{"description":"Generator 5: how kept the place is (a ruined room is rubble, sparsely dressed). Omitted = read from its words, else the place around it.","enum":["intact","weathered","ramshackle","ruined"],"type":"string"},"elevation":{"description":"Base of the floor in tiles. For levels stacked over each other (a dungeon of rooms above rooms) space them 4 apart for the usual 2-tall walls (wall height + 0.5 floor + 1 of air), so a player sees clear air between the wall tops and the floor above; a level under another at 2.5 has walls touching the ceiling. A stairs link grows by a cell per tile, so 4 apart means a 4-cell run. Let the levels overlap in plan (a hall over a crypt, cells under a guard room) and join them with a floor_opening terrain op as well as stairs.","type":"number"},"features":{"items":{"$ref":"#/$defs/feature"},"type":"array"},"foundation":{"description":"Depth of the solid base under the level's edge, tiles 0..4 (default 2 on open-air levels, 0 otherwise).","type":"number"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"labels":{"items":{"$ref":"#/$defs/label"},"type":"array"},"light":{"description":"Generator 5: how many lights mark the place in use, dark (none) to flooded; not the board's brightness. Omitted = read from its words, else the place around it.","enum":["dark","dim","moderate","bright","flooded"],"type":"string"},"lines":{"description":"Generator 3. A line strung overhead between two cells on one row or column: lanterns (rope with lanterns hung along it), lights (a string of lights) or flags (rope with cloth flags; the data has no bunting piece). Each end is anchored on a building wall within 3 cells beyond it, else on a post the generator stands there; the line hangs \`height\` tiles up (2 to 3, default 2.6, clear of shop awnings). A wall shorter than the line cannot hold it: the build warns (verify_line_unanchored) and the pieces float, so end such a line on a post or pick taller buildings. Generator 5: a line over the canopy or awning of a shop front is raised above it, or dropped (line_unanchored) when its walls cannot hold it that high, so end it clear of such fronts. Example across a street between facing buildings: {\\"id\\": \\"across1\\", \\"from\\": [12, 14], \\"to\\": [12, 22], \\"kind\\": \\"lanterns\\"}. Lines over a street are the way to light it from above; do not float lanterns with lift.","items":{"additionalProperties":false,"properties":{"from":{"items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"height":{"type":"number"},"id":{"type":"string"},"kind":{"enum":["lanterns","lights","flags"],"type":"string"},"spacing":{"description":"Cells between hung pieces, 2 to 6 (default 3).","type":"integer"},"to":{"items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"}},"required":["id","from","to"],"type":"object"},"maxItems":12,"type":"array"},"name":{"type":"string"},"notes":{"type":"string"},"openings":{"items":{"$ref":"#/$defs/opening"},"type":"array"},"outline":{"description":"The board's edge (generator 2). natural (default on open-air natural levels at least 16x16 with no roads and fewer than 3 buildings): a ragged, rounded edge with a low strip round the outside. Choose rect for built-up maps (streets, towns), a map that must tile against another, or when the GM asks for a full rectangle.","enum":["natural","rect"],"type":"string"},"roomDress":{"const":false,"description":"Generator 4. false turns off the default dressing of rooms (a room whose name, tags or notes say its purpose, with no dress op over it and little furniture of its own, is furnished and lit from that purpose). Leave it out."},"stalls":{"description":"Generator 3. Rows or clusters of market stalls, laid out for you in a rectangle whose long side is the row, kinds from \`goods\` in shuffled order; cells already taken (a well, a building) are skipped. Generator 4: covered stalls that differ: small 2x3, medium 3x3, large 4x4 (and 4x3, 3x2, 2x2), a raised base, skirted counters with a walk-in gap or goods trays, corner posts, a gable or flat cloth canopy, a stool and a lantern, an empty one when \`goods\` has \\"empty\\", a few open tables, loose gaps and the odd turned stall. Two rows face each other across the aisle when the rectangle is at least aisle + 4 deep (aisle + 6 for full-size stalls), else one row up to 4 deep faces \`facing\`. A theme without canopy pieces builds generator 3's stalls. Keep overhead lines along the aisle or street: a line through a covered stall is dropped. Generator 3: tables 2 cells wide, spaced irregularly, two rows from aisle + 2 deep; fruit, vegetables, spices, magic and weapons use the theme's stall pieces, the rest a bare table with bread, dairy, fish, potions or grain on it. Example: {\\"id\\": \\"market\\", \\"area\\": {\\"x\\": 17, \\"y\\": 6, \\"w\\": 14, \\"h\\": 7}, \\"goods\\": [\\"fruit\\", \\"bread\\", \\"potions\\", \\"vegetables\\"]}. A single stall: a feature of type stall with variant = the kind. Do not dress the same square with the plaza preset: it plants trees and seats in the aisle.","items":{"additionalProperties":false,"properties":{"aisle":{"description":"Clear aisle between two rows, 1 to 4 cells (default 2).","type":"integer"},"area":{"additionalProperties":false,"properties":{"h":{"type":"integer"},"w":{"type":"integer"},"x":{"type":"integer"},"y":{"type":"integer"}},"required":["x","y","w","h"],"type":"object"},"count":{"description":"Most stalls (default: as many as fit).","type":"integer"},"facing":{"description":"The side a lone row faces (default S).","enum":["N","E","S","W"],"type":"string"},"goods":{"description":"Kinds on offer; default fruit, vegetables, bread, dairy, potions, spices.","items":{"enum":["fruit","vegetables","spices","magic","weapons","empty","bread","dairy","fish","potions","grain"],"type":"string"},"type":"array"},"id":{"type":"string"},"seed":{"type":"integer"}},"required":["id","area"],"type":"object"},"maxItems":8,"type":"array"},"structures":{"items":{"$ref":"#/$defs/structure"},"maxItems":32,"type":"array"},"terrain":{"items":{"$ref":"#/$defs/terrain"},"type":"array"},"theme":{"type":"string"},"wallHeight":{"description":"Tiles (1 = 5 ft), multiple of 0.25.","type":"number"},"walls":{"items":{"$ref":"#/$defs/wallRun"},"type":"array"},"wealth":{"description":"Generator 5: how plain or rich its trims and contents are. Omitted = read from its words, else the place around it.","enum":["poor","modest","wealthy","lavish"],"type":"string"}},"required":["id","name","elevation","bounds","base"],"type":"object"},"link":{"additionalProperties":false,"description":"A way between two levels. \`from\` is always the LOWER level (lower elevation), \`to\` the upper; walkers go either way. Stairs: \`from.at\` is the first step (the foot, on the lower level) and \`dir\` is the way the run climbs; it covers one cell per tile of rise in a straight line (rise 2.5 = 3 cells, a 1-wide strip, or \`width\` wide), the cell BEHIND the foot (opposite \`dir\`) must be open floor, and the cells the run climbs over must be free floor on the lower level (a corridor the run climbs along becomes the stair). The top lands on the upper level one cell past the last step, which must be open floor there; the run's cells on the upper level become a stair well with no floor. Example: levels hall (elevation 0) and crypt (elevation -2.5); { kind: \\"stairs\\", from: { level: \\"crypt\\", at: [10, 20] }, to: { level: \\"hall\\" }, dir: \\"N\\" } occupies crypt (10,20), (10,19), (10,18), you step on from (10,21) (open floor), and you arrive on the hall at (10,17); the hall cells (10,18..20) get no floor (a stair well). A ladder or trapdoor occupies one cell: { kind: \\"ladder\\", from: { level: \\"shrine\\", at: [15, 20] }, to: { level: \\"crypt\\" } } climbs from shrine (15,20) up through a one-cell hole in the crypt floor at (15,20); you step on from any side cell of the lower level and off beside the hole above. Keep links out of the cells you build features on.","properties":{"dir":{"description":"Stairs/ramp only: the way the run climbs from the foot (from.at).","enum":["N","E","S","W"],"type":"string"},"from":{"additionalProperties":false,"properties":{"at":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"level":{"type":"string"}},"required":["level","at"],"type":"object"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"kind":{"enum":["stairs","spiral_stairs","ladder","ramp","trapdoor","pit_drop"],"type":"string"},"label":{"type":"string"},"notes":{"type":"string"},"to":{"additionalProperties":false,"properties":{"at":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"level":{"type":"string"}},"required":["level"],"type":"object"},"width":{"enum":[1,2],"type":"integer"}},"required":["id","kind","from","to"],"type":"object"},"opening":{"additionalProperties":false,"description":"Give EITHER between (preferred) OR at. secret_door is a wall that looks solid to players and opens only for the GM (always gmOnly): use it for a hidden shrine, vault or escape, with the room behind reached some other way too if players must be able to find it. Generator 4 builds it as one wall piece standing in the doorway; the build notes tell the GM which piece to delete in TaleSpire to open the way.","properties":{"at":{"additionalProperties":false,"properties":{"side":{"enum":["N","E","S","W"],"type":"string"},"x":{"type":"integer"},"y":{"type":"integer"}},"required":["x","y","side"],"type":"object"},"between":{"description":"[areaId, areaId|\\"@outside\\"]","items":{"type":"string"},"maxItems":2,"minItems":2,"type":"array"},"gmOnly":{"type":"boolean"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"kind":{"enum":["door","double_door","locked_door","secret_door","portcullis","archway","open","window","arrow_slit","bars"],"type":"string"},"label":{"type":"string"},"notes":{"type":"string"},"position":{"description":"0..1 along the shared boundary, default 0.5","type":"number"},"width":{"enum":[1,2,3],"type":"integer"}},"required":["id","kind"],"type":"object"},"shape":{"description":"Cell-set shape. A cell is inside iff its center is inside. Prefer rect for rooms, route for corridors, cave/blob for organic spaces.","oneOf":[{"additionalProperties":false,"properties":{"h":{"type":"integer"},"type":{"const":"rect"},"w":{"type":"integer"},"x":{"type":"integer"},"y":{"type":"integer"}},"required":["type","x","y","w","h"],"type":"object"},{"additionalProperties":false,"properties":{"points":{"items":{"description":"[x, y] grid VERTEX (corner) coordinates.","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"maxItems":64,"minItems":3,"type":"array"},"type":{"const":"polygon"}},"required":["type","points"],"type":"object"},{"additionalProperties":false,"properties":{"cx":{"type":"number"},"cy":{"type":"number"},"r":{"type":"number"},"type":{"const":"circle"}},"required":["type","cx","cy","r"],"type":"object"},{"additionalProperties":false,"properties":{"cx":{"type":"number"},"cy":{"type":"number"},"rx":{"type":"number"},"ry":{"type":"number"},"type":{"const":"ellipse"}},"required":["type","cx","cy","rx","ry"],"type":"object"},{"additionalProperties":false,"properties":{"cx":{"type":"number"},"cy":{"type":"number"},"r":{"type":"number"},"roughness":{"description":"0..1, default 0.35","type":"number"},"seed":{"type":"integer"},"type":{"const":"blob"}},"required":["type","cx","cy","r"],"type":"object"},{"additionalProperties":false,"properties":{"fill":{"description":"0.3..0.7, default 0.45","type":"number"},"h":{"type":"integer"},"seed":{"type":"integer"},"steps":{"description":"0..8, default 4","type":"integer"},"type":{"const":"cave"},"w":{"type":"integer"},"x":{"type":"integer"},"y":{"type":"integer"}},"required":["type","x","y","w","h"],"type":"object"},{"additionalProperties":false,"properties":{"rows":{"description":"'#' = in, '.' = out; ≤ 64×64","items":{"type":"string"},"maxItems":64,"type":"array"},"type":{"const":"cells"},"x":{"type":"integer"},"y":{"type":"integer"}},"required":["type","x","y","rows"],"type":"object"},{"additionalProperties":false,"description":"Thick polyline through cell centers; consecutive points axis-aligned.","properties":{"points":{"items":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"minItems":2,"type":"array"},"type":{"const":"path"},"width":{"description":"1..5, default 1","type":"integer"}},"required":["type","points"],"type":"object"},{"additionalProperties":false,"description":"L-shaped corridor between two areas (or cells); never overwrites other areas; auto-adds openings where it meets them.","properties":{"bend":{"enum":["hv","vh"],"type":"string"},"from":{"oneOf":[{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"}]},"openings":{"enum":["door","double_door","locked_door","secret_door","portcullis","archway","open","window","arrow_slit","bars"],"type":"string"},"to":{"oneOf":[{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"}]},"type":{"const":"route"},"width":{"enum":[1,2,3],"type":"integer"}},"required":["type","from","to"],"type":"object"}]},"structure":{"additionalProperties":false,"description":"A building (kind omitted) or a yard (kind \\"enclosure\\"). Buildings: wings, volumes or footprint; everything else comes from the style, the use and the seed unless given (one wing with no storeys list and no roof lets the style draw the whole design). Example: {\\"id\\": \\"bakery\\", \\"style\\": \\"modern_block\\", \\"use\\": \\"shop\\", \\"front\\": \\"S\\", \\"wings\\": [{\\"x\\": 4, \\"y\\": 2, \\"w\\": 7, \\"h\\": 8}]}; bare x, y, w, h on the building are read as that one wing.","properties":{"attachments":{"items":{"additionalProperties":false,"properties":{"depth":{"type":"integer"},"floor":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"position":{"type":"number"},"roof":{"enum":["flat","none"],"type":"string"},"side":{"enum":["N","E","S","W"],"type":"string"},"type":{"description":"built today: porch","enum":["porch","lean_to","balcony","outside_stairs"],"type":"string"},"width":{"type":"integer"}},"required":["type","side"],"type":"object"},"maxItems":8,"type":"array"},"character":{"description":"How the request's adjectives bend the form (combines with condition): twisted = the shaft's storeys step round its axis in turn (a corkscrew), each overhang on a corbel; leaning = storeys step one way; crooked = small random offsets, uneven storeys; top_heavy = upper storeys wider; squat / slender. Leave storeys, roof and volumes unset so the style can draw it.","items":{"enum":["twisted","leaning","crooked","top_heavy","squat","slender"],"type":"string"},"maxItems":4,"type":"array"},"chimneys":{"description":"Chimney breasts in the wall line (on a gable end for a pitched roof); [] for none.","items":{"additionalProperties":false,"properties":{"position":{"type":"number"},"side":{"enum":["N","E","S","W"],"type":"string"}},"required":["side"],"type":"object"},"maxItems":4,"type":"array"},"condition":{"description":"State: words in the request about it must be honoured (ruined, abandoned, burnt → ruined; worn, old, overgrown → weathered). Ruined: falls away from one standing corner (low wall stubs against a tall remnant, ragged tops, holed floors, roof fallen in, a gable wall may stand), breaches, rubble mostly inside, no lights. Weathered: whole, with a patch of roof fallen in, most windows dark, growth and rubble at its foot. Generator 5: ramshackle (older generators build it weathered) is a patched roof, boarded windows, a lean-to, and ramshackle words in its name, tags or notes make an intact or weathered building so too; a ruin loses a few whole bays, and crumbling or collapsed in its words make it a lighter or a heavier one.","enum":["intact","weathered","ramshackle","ruined"],"type":"string"},"corners":{"description":"chamfer cuts the outer corners of every storey","enum":["square","chamfer"],"type":"string"},"encounter":{"type":"string"},"floor":{"description":"enclosure: yard floor","enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"footprint":{"$ref":"#/$defs/shape","description":"Any other ground plan (round, polygonal); built with a flat roof for now."},"front":{"description":"The face toward the street or square: door, shopfront and entrance lights go there. Default: the face onto the most open ground.","enum":["N","E","S","W"],"type":"string"},"gates":{"items":{"additionalProperties":false,"properties":{"position":{"type":"number"},"side":{"enum":["N","E","S","W"],"type":"string"},"width":{"enum":[1,2,3],"type":"integer"}},"required":["side"],"type":"object"},"maxItems":8,"type":"array"},"growth":{"description":"How overgrown a weathered or ruined building is. light (the weathered default): a few vines, a bush or two at the foot. medium (the ruined default): vines on about a fifth of the wall. heavy: vines and creepers climbing from the ground on a third to half of the walls, bushes at the wall feet and inside, plants on the wall tops, a tree in a roofless part. Words overgrown, ivy-covered, reclaimed, abandoned, nature taking it back → heavy.","enum":["none","light","medium","heavy"],"type":"string"},"h":{"type":"integer"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"key":{"description":"Room-key label of the building's ground storey / yard.","type":"string"},"kind":{"enum":["building","enclosure"],"type":"string"},"light":{"description":"Generator 5: how many lights mark the place in use, dark (none) to flooded; not the board's brightness. Omitted = read from its words, else the place around it.","enum":["dark","dim","moderate","bright","flooded"],"type":"string"},"lighting":{"additionalProperties":false,"description":"Override the style's lights.","properties":{"colour":{"description":"glow colour, e.g. violet","type":"string"},"doors":{"description":"a light beside every door","type":"boolean"},"strips":{"description":"light strips flanking the main entrance","type":"boolean"},"windows":{"description":"lit windows: warm room light or a magical glow","enum":["none","warm","glow"],"type":"string"}},"type":"object"},"name":{"type":"string"},"notes":{"type":"string"},"openings":{"description":"Doors, windows, arches by face. Without a door the building gets one on a face the seed picks.","items":{"additionalProperties":false,"properties":{"kind":{"enum":["door","double_door","locked_door","secret_door","portcullis","archway","open","window","arrow_slit","bars"],"type":"string"},"position":{"description":"0..1 along that face","type":"number"},"side":{"enum":["N","E","S","W"],"type":"string"},"storey":{"type":"integer"},"width":{"enum":[1,2,3],"type":"integer"}},"required":["kind","side"],"type":"object"},"maxItems":32,"type":"array"},"plinth":{"additionalProperties":false,"description":"A raised base under the building (a crag, a podium) with steps to every door.","properties":{"approach":{"enum":["steps","none"],"type":"string"},"face":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"height":{"description":"0.5..6 tiles","type":"number"},"margin":{"description":"cells of base round the walls, 1..4","type":"integer"},"rim":{"enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"}},"required":["height"],"type":"object"},"readAloud":{"type":"string"},"roof":{"oneOf":[{"const":"none"},{"additionalProperties":false,"properties":{"broken":{"description":"0..0.6 fraction of roof built broken (ruins); default 0","type":"number"},"courses":{"description":"skirt, stepped: rings (1..6); spire: flared bands","type":"integer"},"deck":{"type":"boolean"},"layers":{"description":"Stacked roof strategies, bottom first, each on the flat top the one below leaves (skirt then spire; stepped then flat).","items":{"additionalProperties":false,"properties":{"courses":{"description":"skirt, stepped: rings (1..6); spire: flared bands","type":"integer"},"low":{"enum":["N","E","S","W"],"type":"string"},"parapet":{"enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"ridge":{"enum":["ew","ns"],"type":"string"},"style":{"type":"string"},"type":{"description":"built: gable, hip, shed, flat, skirt (mansard ring), stepped, spire (cone builds as spire), none; dome and vault are built flat for now","enum":["gable","flat","none","hip","shed","cone","dome","skirt","stepped","spire","vault"],"type":"string"}},"required":["type"],"type":"object"},"maxItems":4,"type":"array"},"low":{"description":"shed: the side the roof falls to","enum":["N","E","S","W"],"type":"string"},"parapet":{"enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"ridge":{"enum":["ew","ns"],"type":"string"},"style":{"description":"roof kit, e.g. slate","type":"string"},"type":{"description":"built: gable, hip, shed, flat, skirt (mansard ring), stepped, spire (cone builds as spire), none; dome and vault are built flat for now","enum":["gable","flat","none","hip","shed","cone","dome","skirt","stepped","spire","vault"],"type":"string"}},"required":["type"],"type":"object"}]},"roofFurniture":{"additionalProperties":false,"description":"Override the style's roof furniture.","properties":{"clutter":{"description":"0..0.5 share of a flat roof covered by vents, crates and the like","type":"number"},"dormers":{"type":"boolean"},"finial":{"type":"boolean"},"hut":{"description":"a stair hut on a flat roof","type":"boolean"},"mast":{"type":"boolean"}},"type":"object"},"seed":{"description":"Another seed gives another variant of the same spec (door slide, windows, porch, chimney).","type":"integer"},"shape":{"$ref":"#/$defs/shape","description":"enclosure: the yard"},"shopfront":{"description":"ground storey on the front face as a shopfront (wide glazing, sign band). Works on cottage and the other styles too (generator 3: corner cells keep their wall); a trade \`use\` sets it for you.","type":"boolean"},"storeyHeight":{"description":"wall height of each storey in tiles, 1..8 in steps of 0.25 (default from the style)","type":"number"},"storeys":{"oneOf":[{"description":"1..12","type":"integer"},{"items":{"additionalProperties":false,"properties":{"floor":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"footing":{"description":"ground storey only: a lower course (stone under timber)","enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"height":{"description":"this storey's wall height, 1..8 tiles","type":"number"},"inset":{"description":"0..2 cells this storey steps in from the one below on every side","type":"integer"},"seam":{"description":"the ledge a set-in leaves: roofed, plain or battlemented","enum":["skirt","plain","crenellated"],"type":"string"},"walls":{"enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"windows":{"enum":["none","sparse","regular","dense"],"type":"string"}},"type":"object"},"maxItems":12,"type":"array"}]},"style":{"description":"Style profile: cottage: timber walls on a stone footing, pitched slate roof on an attic deck, windows every few cells, a light by the door; keep: thick stone walls, few narrow windows, flat roof with a stone parapet, battlemented ledges where storeys step in; tower: tall and narrow stone storeys, sparse windows, a spire; wizard_tower: a slender tapering shaft (grey stone, red brick on a stone foot, sandstone or dark stone), a lantern room under a steep spire with a finial or a magic orb (the lantern sometimes half-timbered), bartizans or a stair turret, glowing windows, on a raised rocky base; ruin: an old building fallen to ruin (for a ruined tower, cottage, keep or warehouse use that style with condition \\"ruined\\" instead, so it keeps its kind); modern: plain panel walls, many large windows, flat roof with a low parapet; modern_block: a city building drawn from many shapes (plain block, set-back top, podium and tower, twin heights, corner L, stepped, low shed) in brick, concrete, metal or panel, with a shopfront, stoop or garage at street level, varied windows, flat parapet roofs with a hut, plant, mast or terrace; desert: plastered walls, few small windows, flat roof with a low parapet. Default cottage.","type":"string"},"tags":{"items":{"type":"string"},"type":"array"},"theme":{"type":"string"},"use":{"description":"What the building is for (shop, apartments, office, warehouse, garage, townhouse, diner, civic, workshop; shack, farmhouse, tavern …). Leave shape and looks to the style and set a different use per building: the style draws silhouette, material, roof, windows and street level from it. Generator 3 cottages know trades: baker, smith, shop (store, general, grocer), butcher, apothecary (herbalist), cobbler, tailor, inn (tavern): each gets a glazed shop front with a sign, a tent-cloth awning over it and a few trade props outside the door (sacks, anvil, crates, barrels, benches). Neighbours that share a wall stand wing to wing; vary wing depth by a cell so the street front is not a ruler line. Generator 5: the use also picks the ground storey's rooms (an inn's taproom and kitchen, a shop floor and store, a workshop, a shrine, a guardroom and armoury, a store room and office, else a home).","type":"string"},"volumes":{"description":"Massing: blocks of different heights instead of wings, e.g. a tall tenement beside a low warehouse. Each has its own storeys, storeyHeight and roof; on: the volume it stands on (a tower on a hall). The ground volumes together are the ground storey.","items":{"additionalProperties":false,"properties":{"corners":{"enum":["square","chamfer"],"type":"string"},"h":{"type":"integer"},"id":{"description":"short volume id, unique in the building","type":"string"},"on":{"description":"id of the volume it stands on","type":"string"},"ridge":{"enum":["ew","ns"],"type":"string"},"roof":{"oneOf":[{"const":"none"},{"additionalProperties":false,"properties":{"broken":{"description":"0..0.6 fraction of roof built broken (ruins); default 0","type":"number"},"courses":{"description":"skirt, stepped: rings (1..6); spire: flared bands","type":"integer"},"deck":{"type":"boolean"},"layers":{"description":"Stacked roof strategies, bottom first, each on the flat top the one below leaves (skirt then spire; stepped then flat).","items":{"additionalProperties":false,"properties":{"courses":{"description":"skirt, stepped: rings (1..6); spire: flared bands","type":"integer"},"low":{"enum":["N","E","S","W"],"type":"string"},"parapet":{"enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"ridge":{"enum":["ew","ns"],"type":"string"},"style":{"type":"string"},"type":{"description":"built: gable, hip, shed, flat, skirt (mansard ring), stepped, spire (cone builds as spire), none; dome and vault are built flat for now","enum":["gable","flat","none","hip","shed","cone","dome","skirt","stepped","spire","vault"],"type":"string"}},"required":["type"],"type":"object"},"maxItems":4,"type":"array"},"low":{"description":"shed: the side the roof falls to","enum":["N","E","S","W"],"type":"string"},"parapet":{"enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"ridge":{"enum":["ew","ns"],"type":"string"},"style":{"description":"roof kit, e.g. slate","type":"string"},"type":{"description":"built: gable, hip, shed, flat, skirt (mansard ring), stepped, spire (cone builds as spire), none; dome and vault are built flat for now","enum":["gable","flat","none","hip","shed","cone","dome","skirt","stepped","spire","vault"],"type":"string"}},"required":["type"],"type":"object"}]},"storeyHeight":{"type":"number"},"storeys":{"oneOf":[{"description":"1..12","type":"integer"},{"items":{"additionalProperties":false,"properties":{"floor":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"footing":{"description":"ground storey only: a lower course (stone under timber)","enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"height":{"description":"this storey's wall height, 1..8 tiles","type":"number"},"inset":{"description":"0..2 cells this storey steps in from the one below on every side","type":"integer"},"seam":{"description":"the ledge a set-in leaves: roofed, plain or battlemented","enum":["skirt","plain","crenellated"],"type":"string"},"walls":{"enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"windows":{"enum":["none","sparse","regular","dense"],"type":"string"}},"type":"object"},"maxItems":12,"type":"array"}]},"w":{"type":"integer"},"x":{"type":"integer"},"y":{"type":"integer"}},"required":["id","x","y","w","h"],"type":"object"},"maxItems":8,"type":"array"},"w":{"type":"integer"},"wall":{"description":"enclosure: fence style (default fence)","enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"wealth":{"description":"Generator 5: how plain or rich its trims and contents are. Omitted = read from its words, else the place around it.","enum":["poor","modest","wealthy","lavish"],"type":"string"},"windows":{"enum":["none","sparse","regular","dense"],"type":"string"},"wings":{"description":"Rectangles whose union is the footprint (an L or T is two wings); each gets its own roof ridge (default along its longer side).","items":{"additionalProperties":false,"properties":{"h":{"type":"integer"},"ridge":{"enum":["ew","ns"],"type":"string"},"w":{"type":"integer"},"x":{"type":"integer"},"y":{"type":"integer"}},"required":["x","y","w","h"],"type":"object"},"maxItems":8,"type":"array"},"x":{"description":"shorthand: x, y, w, h = wings [{x, y, w, h}]","type":"integer"},"y":{"type":"integer"}},"required":["id"],"type":"object"},"terrain":{"oneOf":[{"additionalProperties":false,"properties":{"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"layer":{"description":"under (default) = applied before the areas: paint/noise/path under are replaced wherever an area sets its floor (use under for outdoor ground and roads); a height op under sets the ground height that areas without floorHeight inherit. over = applied after the areas, on their floor (water or lava in a cave, a dais or pit inside a room).","enum":["under","over"],"type":"string"},"material":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"op":{"const":"paint"},"shape":{"$ref":"#/$defs/shape"}},"required":["id","op","shape","material"],"type":"object"},{"additionalProperties":false,"properties":{"delta":{"description":"Tiles (1 = 5 ft), multiple of 0.25.","type":"number"},"edge":{"description":"ragged breaks the outline (natural ground; default on open-air levels).","enum":["ragged","clean"],"type":"string"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"layer":{"description":"under (default) = applied before the areas: paint/noise/path under are replaced wherever an area sets its floor (use under for outdoor ground and roads); a height op under sets the ground height that areas without floorHeight inherit. over = applied after the areas, on their floor (water or lava in a cave, a dais or pit inside a room).","enum":["under","over"],"type":"string"},"op":{"const":"height"},"set":{"description":"Tiles (1 = 5 ft), multiple of 0.25.","type":"number"},"shape":{"$ref":"#/$defs/shape"},"smooth":{"type":"integer"}},"required":["id","op","shape"],"type":"object"},{"additionalProperties":false,"properties":{"coverage":{"type":"number"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"layer":{"description":"under (default) = applied before the areas: paint/noise/path under are replaced wherever an area sets its floor (use under for outdoor ground and roads); a height op under sets the ground height that areas without floorHeight inherit. over = applied after the areas, on their floor (water or lava in a cave, a dais or pit inside a room).","enum":["under","over"],"type":"string"},"material":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"op":{"const":"noise"},"scale":{"type":"integer"},"seed":{"type":"integer"},"shape":{"$ref":"#/$defs/shape"}},"required":["id","op","shape","material","coverage"],"type":"object"},{"additionalProperties":false,"description":"Road, trail, track or stream bed of a material along a line: give points (cell centres), or connect (area ids, feature ids or [x,y] cells joined in order, winding with jitter). kerb edges it with kerb pieces.","properties":{"connect":{"items":{"oneOf":[{"type":"string"},{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"}]},"maxItems":16,"minItems":2,"type":"array"},"crossings":{"description":"Pedestrian crossings at these fractions of the road's length (0..1); makes the path a road.","items":{"type":"number"},"type":"array"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"jitter":{"type":"number"},"kerb":{"description":"Broken kerb stones here and there along the path's edges.","type":"boolean"},"layer":{"description":"under (default) = applied before the areas: paint/noise/path under are replaced wherever an area sets its floor (use under for outdoor ground and roads); a height op under sets the ground height that areas without floorHeight inherit. over = applied after the areas, on their floor (water or lava in a cave, a dais or pit inside a room).","enum":["under","over"],"type":"string"},"material":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"op":{"const":"path"},"points":{"items":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"minItems":2,"type":"array"},"seed":{"type":"integer"},"sidewalk":{"additionalProperties":false,"description":"Makes the path a road (straight, no jitter) with a raised pavement on both sides and kerbs between (kerb false turns them off).","properties":{"material":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"raise":{"description":"pavement height above the road, tiles (default 0.25)","type":"number"},"width":{"type":"integer"}},"required":["width","material"],"type":"object"},"style":{"description":"natural winds and varies in width (default for dirt, gravel, grass, sand, mud, snow, rock); straight for paved roads and corridors.","enum":["natural","straight"],"type":"string"},"width":{"type":"integer"}},"required":["id","op","width","material"],"type":"object"},{"additionalProperties":false,"properties":{"avoid":{"items":{"enum":["water","paths","areas","walls","features","links"],"type":"string"},"type":"array"},"density":{"description":"0..1","type":"number"},"exclude":{"items":{"$ref":"#/$defs/shape"},"maxItems":8,"type":"array"},"feature":{"enum":["table","round_table","chair","bench","stool","bed","bunk_bed","wardrobe","bookshelf","desk","chest","barrel","crate","sack","shelf","counter","bar_counter","throne","rug","cauldron","anvil","forge","weapon_rack","armor_stand","cage","stocks","pillar","statue","altar","fountain","well","brazier","torch_wall","candelabra","banner_wall","painting_wall","sarcophagus","coffin","tomb","bones","rubble","web","debris","pool","lever","trap","trap_plate","chandelier","tree","dead_tree","pine_tree","bush","rock","boulder","stump","log","mushroom","flowers","tall_grass","reeds","campfire","tent","cart","wagon","fence_post","signpost","standing_stone","grave","stalagmite","stalactite","rock_formation","cave_in","crystal","giant_mushroom","root","root_large","roots_wall","vines","tree_large","candles","skull_pile","spawn_point","torch_floor","lantern","magic_fire","lava_glow","fire_pit","monolith","cave_column","statue_large","mine_cart","rails","mine_support","chains","landmark","tall_marker","formation","cluster_tall","undergrowth","ground_cover","accent_light","edge_dressing","small_detail","wall_dressing","bank_dressing","jetty","vehicle","seating","signage","cliff_face","cliff_crest","stall","goods","overhead","line_post","clutter","shelf_line","custom"],"type":"string"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"minSpacing":{"type":"integer"},"op":{"const":"scatter"},"randomRotation":{"type":"boolean"},"seed":{"type":"integer"},"shape":{"$ref":"#/$defs/shape"},"variants":{"items":{"type":"string"},"type":"array"}},"required":["id","op","feature","density"],"type":"object"},{"additionalProperties":false,"properties":{"area":{"description":"area: optional on generator 2 — leave it out (or give the level id) to dress the whole level: the open ground and each zone.","type":"string"},"density":{"type":"number"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"op":{"const":"dress"},"preset":{"description":"Generator 4: a room preset (tavern to treasury in this list) furnishes and lights the room as that purpose, the way a room named for it is dressed by default (density 0.5 is the default amount); use one to choose the purpose or the amount.","enum":["tavern","library","barracks","bedroom","kitchen","storeroom","throne_room","shrine","crypt","prison","forge","laboratory","treasury","ruin","camp","ritual_circle","overgrown","cavern","collapse","crystal_grotto","campsite","shrine_ruin","bone_pit","mine_works","mushroom_grove","barricade","natural_clusters","woodland","forest","dense_forest","street","alley","plaza"],"type":"string"},"seed":{"type":"integer"}},"required":["id","op","preset"],"type":"object"},{"additionalProperties":false,"description":"A meandering trench cut into the floor of the areas it crosses (always applied after the areas): a chasm, crevasse, ravine or rift, and also a stream or river bed (floor water_shallow, depth 0.5..1) or a dry gully. Cliff sides, optional bridges across.","properties":{"bridges":{"items":{"additionalProperties":false,"properties":{"arch":{"description":"rise of the middle above the ends, tiles 0..2.","type":"number"},"at":{"description":"0..1 along the chasm (default 0.5).","type":"number"},"crumble":{"description":"0..0.6 fraction of the deck crumbled away (a way across always remains).","type":"number"},"floor":{"description":"Deck material (default flagstone).","enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"railing":{"description":"default low_wall; ruined suits an old bridge.","enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"span":{"description":"default arch (stone) or plank (wood floor).","enum":["arch","flat","plank","natural"],"type":"string"},"width":{"description":"1..4 cells (default 2).","type":"integer"}},"type":"object"},"maxItems":4,"type":"array"},"depth":{"description":"Tiles below the floor, 0.5..4, multiple of 0.25 (default 3).","type":"number"},"floor":{"description":"Bottom: lava, water_deep, water_shallow, rock… (default: keep the floor); none = bottomless.","enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete","none"],"type":"string"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"meander":{"description":"0..1 (default 0.5): how much the course and the banks wander.","type":"number"},"op":{"const":"chasm"},"points":{"description":"Course as cell centres, any direction; run it from wall to wall across the room.","items":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"maxItems":64,"minItems":2,"type":"array"},"seed":{"type":"integer"},"width":{"description":"Average width in cells, 1..12.","type":"number"}},"required":["id","op","points","width"],"type":"object"},{"additionalProperties":false,"description":"Tiered platform: dais, stepped pyramid, terrace, raised walkway, plateau; negative rise = sunken pit or amphitheatre. Rings each inset cells inside the one below and rise tiles higher. Cut into open floor (after the areas). Steps of 0.5 are walkable everywhere; stairs adds a flight on those sides.","properties":{"edge":{"description":"ragged = organic wandering contours (mounds, terraces, hills; default on open-air levels for natural materials); clean = crisp built tiers (daises).","enum":["ragged","clean"],"type":"string"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"inset":{"description":"Cells each tier steps in, 1..4 (default 1).","type":"integer"},"material":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"op":{"const":"platform"},"rise":{"description":"Tiles per tier, -2..2, not 0, multiple of 0.25 (default 0.5).","type":"number"},"shape":{"$ref":"#/$defs/shape"},"stairs":{"description":"Sides that get a 2-wide flight of steps to the top.","items":{"enum":["N","E","S","W"],"type":"string"},"maxItems":4,"type":"array"},"tiers":{"description":"1..5 (default 3).","type":"integer"},"topMaterial":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"}},"required":["id","op","shape"],"type":"object"},{"additionalProperties":false,"description":"A straight flight of steps between two floor cells on one row or column, at any two heights (ledge to floor, into a dry chasm, up to a terrace or plateau). The cells between step evenly; every step is walkable.","properties":{"from":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"op":{"const":"stairs"},"style":{"description":"stairs (default): a flight of steps. ramp (generator 2): a rock ramp cut through a cliff, 3..6 cells wide, in any direction (a diagonal suits it), climbing at most 1 tile per 2.5 cells, so it needs a long run. An option for a natural slope where stairs would look built; whether minis walk it in game is not yet confirmed.","enum":["stairs","ramp"],"type":"string"},"to":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"width":{"description":"Stairs 1..3 (default 1); a ramp 3..6 (default 4).","maximum":6,"minimum":1,"type":"integer"}},"required":["id","op","from","to"],"type":"object"},{"additionalProperties":false,"description":"Uneven ground: gentle seeded bumps and hollows that stay walkable. Leave fighting space and paths out with exclude.","properties":{"amount":{"description":"Largest change in tiles, 0.25..1 (default 0.5).","type":"number"},"exclude":{"items":{"$ref":"#/$defs/shape"},"maxItems":8,"type":"array"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"op":{"const":"uneven"},"scale":{"description":"Bump size in cells, 3..12 (default 6).","type":"number"},"seed":{"type":"integer"},"shape":{"$ref":"#/$defs/shape"}},"required":["id","op"],"type":"object"},{"additionalProperties":false,"description":"Outcrop: a rock mass, column, crag or buttress rising out of the floor with cliff sides (any setting).","properties":{"height":{"description":"Tiles, 0.5..4 (default 2).","type":"number"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"material":{"description":"Top surface (default rock).","enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"op":{"const":"outcrop"},"shape":{"$ref":"#/$defs/shape"}},"required":["id","op","shape"],"type":"object"},{"additionalProperties":false,"description":"Generator 3. An opening in the floor of this level so the level below shows through: a collapsed floor, a shaft, a gallery or balcony looking down into a hall. Put it inside a room of the upper level, over open floor of a room on the level below (stack the levels by elevation, one storey = 2.5). No wall is built round it (unlike an area with floor \\"none\\"): the edge gets a low railing or broken rim, a collapse gets a ragged outline and a heap of rubble on the floor below, and the build checks the cells beneath are open floor.","properties":{"edge":{"description":"Outline (default: ragged for a collapse, clean otherwise).","enum":["ragged","clean"],"type":"string"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"kind":{"description":"collapse (default): ragged hole, broken edge, rubble below. shaft: clean hole with a railing. balcony: like shaft, for a gallery over a room.","enum":["collapse","shaft","balcony"],"type":"string"},"op":{"const":"floor_opening"},"rim":{"description":"Edge piece. Generator 4 default: a collapse has none (broken rubble on the rim), a shaft a low_wall kerb, a balcony a railing; never ask for a 2-tall wall style, it hides the hole. Earlier generators: ruined for a collapse, iron_bars otherwise.","enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"rubble":{"description":"Collapse: heap rubble on the floor below (default true).","type":"boolean"},"shape":{"$ref":"#/$defs/shape"}},"required":["id","op","shape"],"type":"object"}]},"wallRun":{"additionalProperties":false,"properties":{"height":{"description":"Tiles (1 = 5 ft), multiple of 0.25.","type":"number"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"op":{"enum":["add","remove"],"type":"string"},"points":{"items":{"description":"[x, y] grid VERTEX (corner) coordinates.","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"maxItems":64,"minItems":2,"type":"array"},"style":{"enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber"],"type":"string"}},"required":["id","op","points"],"type":"object"}},"additionalProperties":false,"properties":{"changes":{"items":{"type":"string"},"maxItems":6,"type":"array"},"plan":{"additionalProperties":false,"properties":{"entryLevel":{"type":"string"},"kind":{"enum":["dungeon","cave","building","tower","town","outdoor","mixed"],"type":"string"},"levels":{"items":{"$ref":"#/$defs/level"},"maxItems":8,"minItems":1,"type":"array"},"links":{"items":{"$ref":"#/$defs/link"},"type":"array"},"notes":{"type":"string"},"seed":{"description":"Optional root seed; omitted = app picks one.","type":"integer"},"summary":{"type":"string"},"theme":{"type":"string"},"title":{"type":"string"}},"required":["title","kind","theme","levels","links"],"type":"object"},"replace":{"type":"boolean"},"summary":{"description":"≤ 80 chars, becomes the version label.","type":"string"}},"required":["replace","summary","plan"],"type":"object"},"name":"create_plan"}
{"description":"Change the existing plan with a batch of operations applied in order as ONE transaction: if any op or the resulting plan is invalid, nothing is applied and you get every problem with hints — fix them and call edit_plan again. Use for every change after the first draft: add/update/remove/move/duplicate elements by id, reshape areas, materialize generated features. Group related changes into one call. baseVersion must be the current plan version.","input_schema":{"$defs":{"area":{"additionalProperties":false,"properties":{"arch":{"description":"bridge only: rise of the middle above the ends, tiles 0..2.","type":"number"},"broken":{"description":"bridge only: deck cells that have fallen away.","items":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"maxItems":64,"type":"array"},"condition":{"description":"Generator 5: how kept the place is (a ruined room is rubble, sparsely dressed). Omitted = read from its words, else the place around it.","enum":["intact","weathered","ramshackle","ruined"],"type":"string"},"crumble":{"description":"bridge only: 0..0.6 fraction of deck cells crumbled away; a way across always remains.","type":"number"},"encounter":{"description":"Encounter line(s) in the brief's game system.","type":"string"},"floor":{"description":"Omitted = the theme default. Generator 4, a room on a solid-base level: leave it off and the room takes a floor from its purpose in the theme's floor family, unlike its neighbours' where it can; a passage or an abandoned room keeps the default. Name a floor only to choose one (naming the theme default counts as leaving it off).","enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete","none"],"type":"string"},"floorHeight":{"description":"Tiles relative to the level, multiple of 0.25, -4..4 (dais 0.5, pit -1). Omitted = keep the height underneath (e.g. from a height op). Generator 4: a room on a solid-base level that a corridor opens into (an opening, a route ending on it, or no wall between) sits a quarter tile above it when this is omitted; 0 keeps it level.","type":"number"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"key":{"description":"Room-key label, e.g. \\"1\\" or \\"A3\\".","type":"string"},"kind":{"description":"zone = names cells only (never changes floor, height or walls). bridge = a walkable deck over a drop: open air under it, railings on the sides facing the drop, deck height = floorHeight or the floor at its ends; list it AFTER the areas it crosses.","enum":["room","corridor","cave","building","courtyard","zone","bridge"],"type":"string"},"labelAt":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"light":{"description":"Generator 5: how many lights mark the place in use, dark (none) to flooded; not the board's brightness. Omitted = read from its words, else the place around it.","enum":["dark","dim","moderate","bright","flooded"],"type":"string"},"name":{"type":"string"},"notes":{"type":"string"},"purpose":{"description":"Generator 4: set it only when the name does not say what the room is for; it wins over the name, tags and notes. Generator 5: the name also picks kinds this list lacks (shop, stable, lounge or parlour, classroom, command, ward or infirmary); leave purpose off for those.","enum":["tavern","dining","kitchen","library","study","armoury","barracks","bedroom","storeroom","shrine","crypt","prison","forge","laboratory","treasury","washroom","throne_room","ruin","passage"],"type":"string"},"railing":{"description":"bridge only: railing style on the edges facing the drop (default low_wall; ruined for a crumbling bridge).","enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"readAloud":{"description":"Boxed text read to players on entry.","type":"string"},"shape":{"$ref":"#/$defs/shape"},"span":{"description":"bridge only: arch (stone, rises to the middle, piers, parapet), flat, plank (wood, sags, rope railing), natural (rock span or fallen column). Default by floor. A bridge whose ends touch floors at different heights becomes an inclined span with steps.","enum":["arch","flat","plank","natural"],"type":"string"},"tags":{"items":{"type":"string"},"type":"array"},"theme":{"type":"string"},"wallHeight":{"description":"Tiles (1 = 5 ft), multiple of 0.25.","type":"number"},"wallStyle":{"enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber"],"type":"string"},"walls":{"enum":["auto","perimeter","none"],"type":"string"},"wealth":{"description":"Generator 5: how plain or rich its trims and contents are. Omitted = read from its words, else the place around it.","enum":["poor","modest","wealthy","lavish"],"type":"string"}},"required":["id","kind","shape"],"type":"object"},"feature":{"additionalProperties":false,"properties":{"at":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"gmOnly":{"type":"boolean"},"hint":{"description":"Required for type \\"custom\\": a plain noun that is a whole word of the game asset's name (\\"wheel\\", \\"anchor\\", \\"skull\\"); its last word must be in the name.","type":"string"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"label":{"type":"string"},"lift":{"description":"Tiles (1 = 5 ft), multiple of 0.25.","type":"number"},"notes":{"type":"string"},"rot":{"enum":[0,90,180,270],"type":"integer"},"size":{"description":"Cells [w, h]. Leave it off for a named type (the piece keeps its own footprint). For custom, the size of the thing: only an asset within about nine times its area either way is taken.","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"type":{"description":"Generator 4: clutter is the small things a room's dressing stands on its furniture (variant table, study, store, tools or shelf) and shelf_line a wall shelf plank for them (needs wall); a room dressed by default or by a preset already has both.","enum":["table","round_table","chair","bench","stool","bed","bunk_bed","wardrobe","bookshelf","desk","chest","barrel","crate","sack","shelf","counter","bar_counter","throne","rug","cauldron","anvil","forge","weapon_rack","armor_stand","cage","stocks","pillar","statue","altar","fountain","well","brazier","torch_wall","candelabra","banner_wall","painting_wall","sarcophagus","coffin","tomb","bones","rubble","web","debris","pool","lever","trap","trap_plate","chandelier","tree","dead_tree","pine_tree","bush","rock","boulder","stump","log","mushroom","flowers","tall_grass","reeds","campfire","tent","cart","wagon","fence_post","signpost","standing_stone","grave","stalagmite","stalactite","rock_formation","cave_in","crystal","giant_mushroom","root","root_large","roots_wall","vines","tree_large","candles","skull_pile","spawn_point","torch_floor","lantern","magic_fire","lava_glow","fire_pit","monolith","cave_column","statue_large","mine_cart","rails","mine_support","chains","landmark","tall_marker","formation","cluster_tall","undergrowth","ground_cover","accent_light","edge_dressing","small_detail","wall_dressing","bank_dressing","jetty","vehicle","seating","signage","cliff_face","cliff_crest","stall","goods","overhead","line_post","clutter","shelf_line","custom"],"type":"string"},"variant":{"type":"string"},"wall":{"enum":["N","E","S","W"],"type":"string"}},"required":["id","type","at"],"type":"object"},"label":{"additionalProperties":false,"properties":{"at":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"size":{"enum":["s","m","l"],"type":"string"},"text":{"type":"string"}},"required":["id","text","at"],"type":"object"},"level":{"additionalProperties":false,"properties":{"areas":{"items":{"$ref":"#/$defs/area"},"type":"array"},"base":{"oneOf":[{"additionalProperties":false,"properties":{"type":{"const":"solid"}},"required":["type"],"type":"object"},{"additionalProperties":false,"properties":{"type":{"const":"void"}},"required":["type"],"type":"object"},{"additionalProperties":false,"properties":{"layer":{"description":"under (default) = applied before the areas: paint/noise/path under are replaced wherever an area sets its floor (use under for outdoor ground and roads); a height op under sets the ground height that areas without floorHeight inherit. over = applied after the areas, on their floor (water or lava in a cave, a dais or pit inside a room).","enum":["under","over"],"type":"string"},"material":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"type":{"const":"ground"}},"required":["type","material"],"type":"object"}]},"bounds":{"additionalProperties":false,"properties":{"h":{"type":"integer"},"w":{"type":"integer"},"x":{"type":"integer"},"y":{"type":"integer"}},"required":["x","y","w","h"],"type":"object"},"condition":{"description":"Generator 5: how kept the place is (a ruined room is rubble, sparsely dressed). Omitted = read from its words, else the place around it.","enum":["intact","weathered","ramshackle","ruined"],"type":"string"},"elevation":{"description":"Base of the floor in tiles. For levels stacked over each other (a dungeon of rooms above rooms) space them 4 apart for the usual 2-tall walls (wall height + 0.5 floor + 1 of air), so a player sees clear air between the wall tops and the floor above; a level under another at 2.5 has walls touching the ceiling. A stairs link grows by a cell per tile, so 4 apart means a 4-cell run. Let the levels overlap in plan (a hall over a crypt, cells under a guard room) and join them with a floor_opening terrain op as well as stairs.","type":"number"},"features":{"items":{"$ref":"#/$defs/feature"},"type":"array"},"foundation":{"description":"Depth of the solid base under the level's edge, tiles 0..4 (default 2 on open-air levels, 0 otherwise).","type":"number"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"labels":{"items":{"$ref":"#/$defs/label"},"type":"array"},"light":{"description":"Generator 5: how many lights mark the place in use, dark (none) to flooded; not the board's brightness. Omitted = read from its words, else the place around it.","enum":["dark","dim","moderate","bright","flooded"],"type":"string"},"lines":{"description":"Generator 3. A line strung overhead between two cells on one row or column: lanterns (rope with lanterns hung along it), lights (a string of lights) or flags (rope with cloth flags; the data has no bunting piece). Each end is anchored on a building wall within 3 cells beyond it, else on a post the generator stands there; the line hangs \`height\` tiles up (2 to 3, default 2.6, clear of shop awnings). A wall shorter than the line cannot hold it: the build warns (verify_line_unanchored) and the pieces float, so end such a line on a post or pick taller buildings. Generator 5: a line over the canopy or awning of a shop front is raised above it, or dropped (line_unanchored) when its walls cannot hold it that high, so end it clear of such fronts. Example across a street between facing buildings: {\\"id\\": \\"across1\\", \\"from\\": [12, 14], \\"to\\": [12, 22], \\"kind\\": \\"lanterns\\"}. Lines over a street are the way to light it from above; do not float lanterns with lift.","items":{"additionalProperties":false,"properties":{"from":{"items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"height":{"type":"number"},"id":{"type":"string"},"kind":{"enum":["lanterns","lights","flags"],"type":"string"},"spacing":{"description":"Cells between hung pieces, 2 to 6 (default 3).","type":"integer"},"to":{"items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"}},"required":["id","from","to"],"type":"object"},"maxItems":12,"type":"array"},"name":{"type":"string"},"notes":{"type":"string"},"openings":{"items":{"$ref":"#/$defs/opening"},"type":"array"},"outline":{"description":"The board's edge (generator 2). natural (default on open-air natural levels at least 16x16 with no roads and fewer than 3 buildings): a ragged, rounded edge with a low strip round the outside. Choose rect for built-up maps (streets, towns), a map that must tile against another, or when the GM asks for a full rectangle.","enum":["natural","rect"],"type":"string"},"roomDress":{"const":false,"description":"Generator 4. false turns off the default dressing of rooms (a room whose name, tags or notes say its purpose, with no dress op over it and little furniture of its own, is furnished and lit from that purpose). Leave it out."},"stalls":{"description":"Generator 3. Rows or clusters of market stalls, laid out for you in a rectangle whose long side is the row, kinds from \`goods\` in shuffled order; cells already taken (a well, a building) are skipped. Generator 4: covered stalls that differ: small 2x3, medium 3x3, large 4x4 (and 4x3, 3x2, 2x2), a raised base, skirted counters with a walk-in gap or goods trays, corner posts, a gable or flat cloth canopy, a stool and a lantern, an empty one when \`goods\` has \\"empty\\", a few open tables, loose gaps and the odd turned stall. Two rows face each other across the aisle when the rectangle is at least aisle + 4 deep (aisle + 6 for full-size stalls), else one row up to 4 deep faces \`facing\`. A theme without canopy pieces builds generator 3's stalls. Keep overhead lines along the aisle or street: a line through a covered stall is dropped. Generator 3: tables 2 cells wide, spaced irregularly, two rows from aisle + 2 deep; fruit, vegetables, spices, magic and weapons use the theme's stall pieces, the rest a bare table with bread, dairy, fish, potions or grain on it. Example: {\\"id\\": \\"market\\", \\"area\\": {\\"x\\": 17, \\"y\\": 6, \\"w\\": 14, \\"h\\": 7}, \\"goods\\": [\\"fruit\\", \\"bread\\", \\"potions\\", \\"vegetables\\"]}. A single stall: a feature of type stall with variant = the kind. Do not dress the same square with the plaza preset: it plants trees and seats in the aisle.","items":{"additionalProperties":false,"properties":{"aisle":{"description":"Clear aisle between two rows, 1 to 4 cells (default 2).","type":"integer"},"area":{"additionalProperties":false,"properties":{"h":{"type":"integer"},"w":{"type":"integer"},"x":{"type":"integer"},"y":{"type":"integer"}},"required":["x","y","w","h"],"type":"object"},"count":{"description":"Most stalls (default: as many as fit).","type":"integer"},"facing":{"description":"The side a lone row faces (default S).","enum":["N","E","S","W"],"type":"string"},"goods":{"description":"Kinds on offer; default fruit, vegetables, bread, dairy, potions, spices.","items":{"enum":["fruit","vegetables","spices","magic","weapons","empty","bread","dairy","fish","potions","grain"],"type":"string"},"type":"array"},"id":{"type":"string"},"seed":{"type":"integer"}},"required":["id","area"],"type":"object"},"maxItems":8,"type":"array"},"structures":{"items":{"$ref":"#/$defs/structure"},"maxItems":32,"type":"array"},"terrain":{"items":{"$ref":"#/$defs/terrain"},"type":"array"},"theme":{"type":"string"},"wallHeight":{"description":"Tiles (1 = 5 ft), multiple of 0.25.","type":"number"},"walls":{"items":{"$ref":"#/$defs/wallRun"},"type":"array"},"wealth":{"description":"Generator 5: how plain or rich its trims and contents are. Omitted = read from its words, else the place around it.","enum":["poor","modest","wealthy","lavish"],"type":"string"}},"required":["id","name","elevation","bounds","base"],"type":"object"},"link":{"additionalProperties":false,"description":"A way between two levels. \`from\` is always the LOWER level (lower elevation), \`to\` the upper; walkers go either way. Stairs: \`from.at\` is the first step (the foot, on the lower level) and \`dir\` is the way the run climbs; it covers one cell per tile of rise in a straight line (rise 2.5 = 3 cells, a 1-wide strip, or \`width\` wide), the cell BEHIND the foot (opposite \`dir\`) must be open floor, and the cells the run climbs over must be free floor on the lower level (a corridor the run climbs along becomes the stair). The top lands on the upper level one cell past the last step, which must be open floor there; the run's cells on the upper level become a stair well with no floor. Example: levels hall (elevation 0) and crypt (elevation -2.5); { kind: \\"stairs\\", from: { level: \\"crypt\\", at: [10, 20] }, to: { level: \\"hall\\" }, dir: \\"N\\" } occupies crypt (10,20), (10,19), (10,18), you step on from (10,21) (open floor), and you arrive on the hall at (10,17); the hall cells (10,18..20) get no floor (a stair well). A ladder or trapdoor occupies one cell: { kind: \\"ladder\\", from: { level: \\"shrine\\", at: [15, 20] }, to: { level: \\"crypt\\" } } climbs from shrine (15,20) up through a one-cell hole in the crypt floor at (15,20); you step on from any side cell of the lower level and off beside the hole above. Keep links out of the cells you build features on.","properties":{"dir":{"description":"Stairs/ramp only: the way the run climbs from the foot (from.at).","enum":["N","E","S","W"],"type":"string"},"from":{"additionalProperties":false,"properties":{"at":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"level":{"type":"string"}},"required":["level","at"],"type":"object"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"kind":{"enum":["stairs","spiral_stairs","ladder","ramp","trapdoor","pit_drop"],"type":"string"},"label":{"type":"string"},"notes":{"type":"string"},"to":{"additionalProperties":false,"properties":{"at":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"level":{"type":"string"}},"required":["level"],"type":"object"},"width":{"enum":[1,2],"type":"integer"}},"required":["id","kind","from","to"],"type":"object"},"op":{"oneOf":[{"additionalProperties":false,"properties":{"element":{"oneOf":[{"additionalProperties":false,"properties":{"index":{"type":"integer"},"kind":{"const":"area"},"level":{"type":"string"},"value":{"$ref":"#/$defs/area"}},"required":["kind","level","value"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"const":"opening"},"level":{"type":"string"},"value":{"$ref":"#/$defs/opening"}},"required":["kind","level","value"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"const":"wall_run"},"level":{"type":"string"},"value":{"$ref":"#/$defs/wallRun"}},"required":["kind","level","value"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"const":"feature"},"level":{"type":"string"},"value":{"$ref":"#/$defs/feature"}},"required":["kind","level","value"],"type":"object"},{"additionalProperties":false,"properties":{"index":{"type":"integer"},"kind":{"const":"terrain"},"level":{"type":"string"},"value":{"$ref":"#/$defs/terrain"}},"required":["kind","level","value"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"const":"label"},"level":{"type":"string"},"value":{"$ref":"#/$defs/label"}},"required":["kind","level","value"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"const":"structure"},"level":{"type":"string"},"value":{"$ref":"#/$defs/structure"}},"required":["kind","level","value"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"const":"link"},"value":{"$ref":"#/$defs/link"}},"required":["kind","value"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"const":"level"},"value":{"$ref":"#/$defs/level"}},"required":["kind","value"],"type":"object"}]},"op":{"const":"add"}},"required":["op","element"],"type":"object"},{"additionalProperties":false,"properties":{"features":{"items":{"$ref":"#/$defs/feature"},"maxItems":500,"type":"array"},"level":{"type":"string"},"op":{"const":"add_features"}},"required":["op","level","features"],"type":"object"},{"additionalProperties":false,"properties":{"id":{"type":"string"},"op":{"const":"update"},"set":{"description":"Fields to overwrite on that element (same field names as when adding it). null deletes an optional field. Nested objects (shape, bounds, from/to, base) are replaced whole.","type":"object"}},"required":["op","id","set"],"type":"object"},{"additionalProperties":false,"properties":{"ids":{"description":"ids may name generated features as results show them (\\"rocks#5\\"); their scatter or dress op is turned into features first.","items":{"type":"string"},"minItems":0,"type":"array"},"keepDependents":{"type":"boolean"},"op":{"const":"remove"},"where":{"additionalProperties":false,"description":"where removes every matching feature in one op.","properties":{"generatedBy":{"type":"string"},"level":{"type":"string"},"rect":{"additionalProperties":false,"properties":{"h":{"type":"integer"},"w":{"type":"integer"},"x":{"type":"integer"},"y":{"type":"integer"}},"required":["x","y","w","h"],"type":"object"},"type":{"enum":["table","round_table","chair","bench","stool","bed","bunk_bed","wardrobe","bookshelf","desk","chest","barrel","crate","sack","shelf","counter","bar_counter","throne","rug","cauldron","anvil","forge","weapon_rack","armor_stand","cage","stocks","pillar","statue","altar","fountain","well","brazier","torch_wall","candelabra","banner_wall","painting_wall","sarcophagus","coffin","tomb","bones","rubble","web","debris","pool","lever","trap","trap_plate","chandelier","tree","dead_tree","pine_tree","bush","rock","boulder","stump","log","mushroom","flowers","tall_grass","reeds","campfire","tent","cart","wagon","fence_post","signpost","standing_stone","grave","stalagmite","stalactite","rock_formation","cave_in","crystal","giant_mushroom","root","root_large","roots_wall","vines","tree_large","candles","skull_pile","spawn_point","torch_floor","lantern","magic_fire","lava_glow","fire_pit","monolith","cave_column","statue_large","mine_cart","rails","mine_support","chains","landmark","tall_marker","formation","cluster_tall","undergrowth","ground_cover","accent_light","edge_dressing","small_detail","wall_dressing","bank_dressing","jetty","vehicle","seating","signage","cliff_face","cliff_crest","stall","goods","overhead","line_post","clutter","shelf_line","custom"],"type":"string"}},"type":"object"}},"required":["op","ids"],"type":"object"},{"additionalProperties":false,"properties":{"dx":{"type":"integer"},"dy":{"type":"integer"},"ids":{"items":{"type":"string"},"minItems":1,"type":"array"},"op":{"const":"move"},"toLevel":{"type":"string"},"withContents":{"type":"boolean"}},"required":["op","ids","dx","dy"],"type":"object"},{"additionalProperties":false,"properties":{"dx":{"type":"integer"},"dy":{"type":"integer"},"idSuffix":{"type":"string"},"ids":{"items":{"type":"string"},"minItems":1,"type":"array"},"op":{"const":"duplicate"},"toLevel":{"type":"string"}},"required":["op","ids","dx","dy","idSuffix"],"type":"object"},{"additionalProperties":false,"properties":{"id":{"type":"string"},"index":{"type":"integer"},"op":{"const":"reorder"}},"required":["op","id","index"],"type":"object"},{"additionalProperties":false,"properties":{"id":{"type":"string"},"keepOp":{"type":"boolean"},"op":{"const":"materialize"}},"required":["op","id"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"enum":["dungeon","cave","building","tower","town","outdoor","mixed"],"type":"string"},"notes":{"type":["string","null"]},"op":{"const":"set_meta"},"seed":{"type":"integer"},"summary":{"type":["string","null"]},"theme":{"type":"string"},"title":{"type":"string"}},"required":["op"],"type":"object"},{"additionalProperties":false,"properties":{"id":{"type":"string"},"op":{"const":"reshape"},"shape":{"$ref":"#/$defs/shape"}},"required":["op","id","shape"],"type":"object"},{"additionalProperties":false,"properties":{"op":{"const":"renumber"}},"required":["op"],"type":"object"}]},"opening":{"additionalProperties":false,"description":"Give EITHER between (preferred) OR at. secret_door is a wall that looks solid to players and opens only for the GM (always gmOnly): use it for a hidden shrine, vault or escape, with the room behind reached some other way too if players must be able to find it. Generator 4 builds it as one wall piece standing in the doorway; the build notes tell the GM which piece to delete in TaleSpire to open the way.","properties":{"at":{"additionalProperties":false,"properties":{"side":{"enum":["N","E","S","W"],"type":"string"},"x":{"type":"integer"},"y":{"type":"integer"}},"required":["x","y","side"],"type":"object"},"between":{"description":"[areaId, areaId|\\"@outside\\"]","items":{"type":"string"},"maxItems":2,"minItems":2,"type":"array"},"gmOnly":{"type":"boolean"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"kind":{"enum":["door","double_door","locked_door","secret_door","portcullis","archway","open","window","arrow_slit","bars"],"type":"string"},"label":{"type":"string"},"notes":{"type":"string"},"position":{"description":"0..1 along the shared boundary, default 0.5","type":"number"},"width":{"enum":[1,2,3],"type":"integer"}},"required":["id","kind"],"type":"object"},"shape":{"description":"Cell-set shape. A cell is inside iff its center is inside. Prefer rect for rooms, route for corridors, cave/blob for organic spaces.","oneOf":[{"additionalProperties":false,"properties":{"h":{"type":"integer"},"type":{"const":"rect"},"w":{"type":"integer"},"x":{"type":"integer"},"y":{"type":"integer"}},"required":["type","x","y","w","h"],"type":"object"},{"additionalProperties":false,"properties":{"points":{"items":{"description":"[x, y] grid VERTEX (corner) coordinates.","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"maxItems":64,"minItems":3,"type":"array"},"type":{"const":"polygon"}},"required":["type","points"],"type":"object"},{"additionalProperties":false,"properties":{"cx":{"type":"number"},"cy":{"type":"number"},"r":{"type":"number"},"type":{"const":"circle"}},"required":["type","cx","cy","r"],"type":"object"},{"additionalProperties":false,"properties":{"cx":{"type":"number"},"cy":{"type":"number"},"rx":{"type":"number"},"ry":{"type":"number"},"type":{"const":"ellipse"}},"required":["type","cx","cy","rx","ry"],"type":"object"},{"additionalProperties":false,"properties":{"cx":{"type":"number"},"cy":{"type":"number"},"r":{"type":"number"},"roughness":{"description":"0..1, default 0.35","type":"number"},"seed":{"type":"integer"},"type":{"const":"blob"}},"required":["type","cx","cy","r"],"type":"object"},{"additionalProperties":false,"properties":{"fill":{"description":"0.3..0.7, default 0.45","type":"number"},"h":{"type":"integer"},"seed":{"type":"integer"},"steps":{"description":"0..8, default 4","type":"integer"},"type":{"const":"cave"},"w":{"type":"integer"},"x":{"type":"integer"},"y":{"type":"integer"}},"required":["type","x","y","w","h"],"type":"object"},{"additionalProperties":false,"properties":{"rows":{"description":"'#' = in, '.' = out; ≤ 64×64","items":{"type":"string"},"maxItems":64,"type":"array"},"type":{"const":"cells"},"x":{"type":"integer"},"y":{"type":"integer"}},"required":["type","x","y","rows"],"type":"object"},{"additionalProperties":false,"description":"Thick polyline through cell centers; consecutive points axis-aligned.","properties":{"points":{"items":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"minItems":2,"type":"array"},"type":{"const":"path"},"width":{"description":"1..5, default 1","type":"integer"}},"required":["type","points"],"type":"object"},{"additionalProperties":false,"description":"L-shaped corridor between two areas (or cells); never overwrites other areas; auto-adds openings where it meets them.","properties":{"bend":{"enum":["hv","vh"],"type":"string"},"from":{"oneOf":[{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"}]},"openings":{"enum":["door","double_door","locked_door","secret_door","portcullis","archway","open","window","arrow_slit","bars"],"type":"string"},"to":{"oneOf":[{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"}]},"type":{"const":"route"},"width":{"enum":[1,2,3],"type":"integer"}},"required":["type","from","to"],"type":"object"}]},"structure":{"additionalProperties":false,"description":"A building (kind omitted) or a yard (kind \\"enclosure\\"). Buildings: wings, volumes or footprint; everything else comes from the style, the use and the seed unless given (one wing with no storeys list and no roof lets the style draw the whole design). Example: {\\"id\\": \\"bakery\\", \\"style\\": \\"modern_block\\", \\"use\\": \\"shop\\", \\"front\\": \\"S\\", \\"wings\\": [{\\"x\\": 4, \\"y\\": 2, \\"w\\": 7, \\"h\\": 8}]}; bare x, y, w, h on the building are read as that one wing.","properties":{"attachments":{"items":{"additionalProperties":false,"properties":{"depth":{"type":"integer"},"floor":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"position":{"type":"number"},"roof":{"enum":["flat","none"],"type":"string"},"side":{"enum":["N","E","S","W"],"type":"string"},"type":{"description":"built today: porch","enum":["porch","lean_to","balcony","outside_stairs"],"type":"string"},"width":{"type":"integer"}},"required":["type","side"],"type":"object"},"maxItems":8,"type":"array"},"character":{"description":"How the request's adjectives bend the form (combines with condition): twisted = the shaft's storeys step round its axis in turn (a corkscrew), each overhang on a corbel; leaning = storeys step one way; crooked = small random offsets, uneven storeys; top_heavy = upper storeys wider; squat / slender. Leave storeys, roof and volumes unset so the style can draw it.","items":{"enum":["twisted","leaning","crooked","top_heavy","squat","slender"],"type":"string"},"maxItems":4,"type":"array"},"chimneys":{"description":"Chimney breasts in the wall line (on a gable end for a pitched roof); [] for none.","items":{"additionalProperties":false,"properties":{"position":{"type":"number"},"side":{"enum":["N","E","S","W"],"type":"string"}},"required":["side"],"type":"object"},"maxItems":4,"type":"array"},"condition":{"description":"State: words in the request about it must be honoured (ruined, abandoned, burnt → ruined; worn, old, overgrown → weathered). Ruined: falls away from one standing corner (low wall stubs against a tall remnant, ragged tops, holed floors, roof fallen in, a gable wall may stand), breaches, rubble mostly inside, no lights. Weathered: whole, with a patch of roof fallen in, most windows dark, growth and rubble at its foot. Generator 5: ramshackle (older generators build it weathered) is a patched roof, boarded windows, a lean-to, and ramshackle words in its name, tags or notes make an intact or weathered building so too; a ruin loses a few whole bays, and crumbling or collapsed in its words make it a lighter or a heavier one.","enum":["intact","weathered","ramshackle","ruined"],"type":"string"},"corners":{"description":"chamfer cuts the outer corners of every storey","enum":["square","chamfer"],"type":"string"},"encounter":{"type":"string"},"floor":{"description":"enclosure: yard floor","enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"footprint":{"$ref":"#/$defs/shape","description":"Any other ground plan (round, polygonal); built with a flat roof for now."},"front":{"description":"The face toward the street or square: door, shopfront and entrance lights go there. Default: the face onto the most open ground.","enum":["N","E","S","W"],"type":"string"},"gates":{"items":{"additionalProperties":false,"properties":{"position":{"type":"number"},"side":{"enum":["N","E","S","W"],"type":"string"},"width":{"enum":[1,2,3],"type":"integer"}},"required":["side"],"type":"object"},"maxItems":8,"type":"array"},"growth":{"description":"How overgrown a weathered or ruined building is. light (the weathered default): a few vines, a bush or two at the foot. medium (the ruined default): vines on about a fifth of the wall. heavy: vines and creepers climbing from the ground on a third to half of the walls, bushes at the wall feet and inside, plants on the wall tops, a tree in a roofless part. Words overgrown, ivy-covered, reclaimed, abandoned, nature taking it back → heavy.","enum":["none","light","medium","heavy"],"type":"string"},"h":{"type":"integer"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"key":{"description":"Room-key label of the building's ground storey / yard.","type":"string"},"kind":{"enum":["building","enclosure"],"type":"string"},"light":{"description":"Generator 5: how many lights mark the place in use, dark (none) to flooded; not the board's brightness. Omitted = read from its words, else the place around it.","enum":["dark","dim","moderate","bright","flooded"],"type":"string"},"lighting":{"additionalProperties":false,"description":"Override the style's lights.","properties":{"colour":{"description":"glow colour, e.g. violet","type":"string"},"doors":{"description":"a light beside every door","type":"boolean"},"strips":{"description":"light strips flanking the main entrance","type":"boolean"},"windows":{"description":"lit windows: warm room light or a magical glow","enum":["none","warm","glow"],"type":"string"}},"type":"object"},"name":{"type":"string"},"notes":{"type":"string"},"openings":{"description":"Doors, windows, arches by face. Without a door the building gets one on a face the seed picks.","items":{"additionalProperties":false,"properties":{"kind":{"enum":["door","double_door","locked_door","secret_door","portcullis","archway","open","window","arrow_slit","bars"],"type":"string"},"position":{"description":"0..1 along that face","type":"number"},"side":{"enum":["N","E","S","W"],"type":"string"},"storey":{"type":"integer"},"width":{"enum":[1,2,3],"type":"integer"}},"required":["kind","side"],"type":"object"},"maxItems":32,"type":"array"},"plinth":{"additionalProperties":false,"description":"A raised base under the building (a crag, a podium) with steps to every door.","properties":{"approach":{"enum":["steps","none"],"type":"string"},"face":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"height":{"description":"0.5..6 tiles","type":"number"},"margin":{"description":"cells of base round the walls, 1..4","type":"integer"},"rim":{"enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"}},"required":["height"],"type":"object"},"readAloud":{"type":"string"},"roof":{"oneOf":[{"const":"none"},{"additionalProperties":false,"properties":{"broken":{"description":"0..0.6 fraction of roof built broken (ruins); default 0","type":"number"},"courses":{"description":"skirt, stepped: rings (1..6); spire: flared bands","type":"integer"},"deck":{"type":"boolean"},"layers":{"description":"Stacked roof strategies, bottom first, each on the flat top the one below leaves (skirt then spire; stepped then flat).","items":{"additionalProperties":false,"properties":{"courses":{"description":"skirt, stepped: rings (1..6); spire: flared bands","type":"integer"},"low":{"enum":["N","E","S","W"],"type":"string"},"parapet":{"enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"ridge":{"enum":["ew","ns"],"type":"string"},"style":{"type":"string"},"type":{"description":"built: gable, hip, shed, flat, skirt (mansard ring), stepped, spire (cone builds as spire), none; dome and vault are built flat for now","enum":["gable","flat","none","hip","shed","cone","dome","skirt","stepped","spire","vault"],"type":"string"}},"required":["type"],"type":"object"},"maxItems":4,"type":"array"},"low":{"description":"shed: the side the roof falls to","enum":["N","E","S","W"],"type":"string"},"parapet":{"enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"ridge":{"enum":["ew","ns"],"type":"string"},"style":{"description":"roof kit, e.g. slate","type":"string"},"type":{"description":"built: gable, hip, shed, flat, skirt (mansard ring), stepped, spire (cone builds as spire), none; dome and vault are built flat for now","enum":["gable","flat","none","hip","shed","cone","dome","skirt","stepped","spire","vault"],"type":"string"}},"required":["type"],"type":"object"}]},"roofFurniture":{"additionalProperties":false,"description":"Override the style's roof furniture.","properties":{"clutter":{"description":"0..0.5 share of a flat roof covered by vents, crates and the like","type":"number"},"dormers":{"type":"boolean"},"finial":{"type":"boolean"},"hut":{"description":"a stair hut on a flat roof","type":"boolean"},"mast":{"type":"boolean"}},"type":"object"},"seed":{"description":"Another seed gives another variant of the same spec (door slide, windows, porch, chimney).","type":"integer"},"shape":{"$ref":"#/$defs/shape","description":"enclosure: the yard"},"shopfront":{"description":"ground storey on the front face as a shopfront (wide glazing, sign band). Works on cottage and the other styles too (generator 3: corner cells keep their wall); a trade \`use\` sets it for you.","type":"boolean"},"storeyHeight":{"description":"wall height of each storey in tiles, 1..8 in steps of 0.25 (default from the style)","type":"number"},"storeys":{"oneOf":[{"description":"1..12","type":"integer"},{"items":{"additionalProperties":false,"properties":{"floor":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"footing":{"description":"ground storey only: a lower course (stone under timber)","enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"height":{"description":"this storey's wall height, 1..8 tiles","type":"number"},"inset":{"description":"0..2 cells this storey steps in from the one below on every side","type":"integer"},"seam":{"description":"the ledge a set-in leaves: roofed, plain or battlemented","enum":["skirt","plain","crenellated"],"type":"string"},"walls":{"enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"windows":{"enum":["none","sparse","regular","dense"],"type":"string"}},"type":"object"},"maxItems":12,"type":"array"}]},"style":{"description":"Style profile: cottage: timber walls on a stone footing, pitched slate roof on an attic deck, windows every few cells, a light by the door; keep: thick stone walls, few narrow windows, flat roof with a stone parapet, battlemented ledges where storeys step in; tower: tall and narrow stone storeys, sparse windows, a spire; wizard_tower: a slender tapering shaft (grey stone, red brick on a stone foot, sandstone or dark stone), a lantern room under a steep spire with a finial or a magic orb (the lantern sometimes half-timbered), bartizans or a stair turret, glowing windows, on a raised rocky base; ruin: an old building fallen to ruin (for a ruined tower, cottage, keep or warehouse use that style with condition \\"ruined\\" instead, so it keeps its kind); modern: plain panel walls, many large windows, flat roof with a low parapet; modern_block: a city building drawn from many shapes (plain block, set-back top, podium and tower, twin heights, corner L, stepped, low shed) in brick, concrete, metal or panel, with a shopfront, stoop or garage at street level, varied windows, flat parapet roofs with a hut, plant, mast or terrace; desert: plastered walls, few small windows, flat roof with a low parapet. Default cottage.","type":"string"},"tags":{"items":{"type":"string"},"type":"array"},"theme":{"type":"string"},"use":{"description":"What the building is for (shop, apartments, office, warehouse, garage, townhouse, diner, civic, workshop; shack, farmhouse, tavern …). Leave shape and looks to the style and set a different use per building: the style draws silhouette, material, roof, windows and street level from it. Generator 3 cottages know trades: baker, smith, shop (store, general, grocer), butcher, apothecary (herbalist), cobbler, tailor, inn (tavern): each gets a glazed shop front with a sign, a tent-cloth awning over it and a few trade props outside the door (sacks, anvil, crates, barrels, benches). Neighbours that share a wall stand wing to wing; vary wing depth by a cell so the street front is not a ruler line. Generator 5: the use also picks the ground storey's rooms (an inn's taproom and kitchen, a shop floor and store, a workshop, a shrine, a guardroom and armoury, a store room and office, else a home).","type":"string"},"volumes":{"description":"Massing: blocks of different heights instead of wings, e.g. a tall tenement beside a low warehouse. Each has its own storeys, storeyHeight and roof; on: the volume it stands on (a tower on a hall). The ground volumes together are the ground storey.","items":{"additionalProperties":false,"properties":{"corners":{"enum":["square","chamfer"],"type":"string"},"h":{"type":"integer"},"id":{"description":"short volume id, unique in the building","type":"string"},"on":{"description":"id of the volume it stands on","type":"string"},"ridge":{"enum":["ew","ns"],"type":"string"},"roof":{"oneOf":[{"const":"none"},{"additionalProperties":false,"properties":{"broken":{"description":"0..0.6 fraction of roof built broken (ruins); default 0","type":"number"},"courses":{"description":"skirt, stepped: rings (1..6); spire: flared bands","type":"integer"},"deck":{"type":"boolean"},"layers":{"description":"Stacked roof strategies, bottom first, each on the flat top the one below leaves (skirt then spire; stepped then flat).","items":{"additionalProperties":false,"properties":{"courses":{"description":"skirt, stepped: rings (1..6); spire: flared bands","type":"integer"},"low":{"enum":["N","E","S","W"],"type":"string"},"parapet":{"enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"ridge":{"enum":["ew","ns"],"type":"string"},"style":{"type":"string"},"type":{"description":"built: gable, hip, shed, flat, skirt (mansard ring), stepped, spire (cone builds as spire), none; dome and vault are built flat for now","enum":["gable","flat","none","hip","shed","cone","dome","skirt","stepped","spire","vault"],"type":"string"}},"required":["type"],"type":"object"},"maxItems":4,"type":"array"},"low":{"description":"shed: the side the roof falls to","enum":["N","E","S","W"],"type":"string"},"parapet":{"enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"ridge":{"enum":["ew","ns"],"type":"string"},"style":{"description":"roof kit, e.g. slate","type":"string"},"type":{"description":"built: gable, hip, shed, flat, skirt (mansard ring), stepped, spire (cone builds as spire), none; dome and vault are built flat for now","enum":["gable","flat","none","hip","shed","cone","dome","skirt","stepped","spire","vault"],"type":"string"}},"required":["type"],"type":"object"}]},"storeyHeight":{"type":"number"},"storeys":{"oneOf":[{"description":"1..12","type":"integer"},{"items":{"additionalProperties":false,"properties":{"floor":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"footing":{"description":"ground storey only: a lower course (stone under timber)","enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"height":{"description":"this storey's wall height, 1..8 tiles","type":"number"},"inset":{"description":"0..2 cells this storey steps in from the one below on every side","type":"integer"},"seam":{"description":"the ledge a set-in leaves: roofed, plain or battlemented","enum":["skirt","plain","crenellated"],"type":"string"},"walls":{"enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"windows":{"enum":["none","sparse","regular","dense"],"type":"string"}},"type":"object"},"maxItems":12,"type":"array"}]},"w":{"type":"integer"},"x":{"type":"integer"},"y":{"type":"integer"}},"required":["id","x","y","w","h"],"type":"object"},"maxItems":8,"type":"array"},"w":{"type":"integer"},"wall":{"description":"enclosure: fence style (default fence)","enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"wealth":{"description":"Generator 5: how plain or rich its trims and contents are. Omitted = read from its words, else the place around it.","enum":["poor","modest","wealthy","lavish"],"type":"string"},"windows":{"enum":["none","sparse","regular","dense"],"type":"string"},"wings":{"description":"Rectangles whose union is the footprint (an L or T is two wings); each gets its own roof ridge (default along its longer side).","items":{"additionalProperties":false,"properties":{"h":{"type":"integer"},"ridge":{"enum":["ew","ns"],"type":"string"},"w":{"type":"integer"},"x":{"type":"integer"},"y":{"type":"integer"}},"required":["x","y","w","h"],"type":"object"},"maxItems":8,"type":"array"},"x":{"description":"shorthand: x, y, w, h = wings [{x, y, w, h}]","type":"integer"},"y":{"type":"integer"}},"required":["id"],"type":"object"},"terrain":{"oneOf":[{"additionalProperties":false,"properties":{"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"layer":{"description":"under (default) = applied before the areas: paint/noise/path under are replaced wherever an area sets its floor (use under for outdoor ground and roads); a height op under sets the ground height that areas without floorHeight inherit. over = applied after the areas, on their floor (water or lava in a cave, a dais or pit inside a room).","enum":["under","over"],"type":"string"},"material":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"op":{"const":"paint"},"shape":{"$ref":"#/$defs/shape"}},"required":["id","op","shape","material"],"type":"object"},{"additionalProperties":false,"properties":{"delta":{"description":"Tiles (1 = 5 ft), multiple of 0.25.","type":"number"},"edge":{"description":"ragged breaks the outline (natural ground; default on open-air levels).","enum":["ragged","clean"],"type":"string"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"layer":{"description":"under (default) = applied before the areas: paint/noise/path under are replaced wherever an area sets its floor (use under for outdoor ground and roads); a height op under sets the ground height that areas without floorHeight inherit. over = applied after the areas, on their floor (water or lava in a cave, a dais or pit inside a room).","enum":["under","over"],"type":"string"},"op":{"const":"height"},"set":{"description":"Tiles (1 = 5 ft), multiple of 0.25.","type":"number"},"shape":{"$ref":"#/$defs/shape"},"smooth":{"type":"integer"}},"required":["id","op","shape"],"type":"object"},{"additionalProperties":false,"properties":{"coverage":{"type":"number"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"layer":{"description":"under (default) = applied before the areas: paint/noise/path under are replaced wherever an area sets its floor (use under for outdoor ground and roads); a height op under sets the ground height that areas without floorHeight inherit. over = applied after the areas, on their floor (water or lava in a cave, a dais or pit inside a room).","enum":["under","over"],"type":"string"},"material":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"op":{"const":"noise"},"scale":{"type":"integer"},"seed":{"type":"integer"},"shape":{"$ref":"#/$defs/shape"}},"required":["id","op","shape","material","coverage"],"type":"object"},{"additionalProperties":false,"description":"Road, trail, track or stream bed of a material along a line: give points (cell centres), or connect (area ids, feature ids or [x,y] cells joined in order, winding with jitter). kerb edges it with kerb pieces.","properties":{"connect":{"items":{"oneOf":[{"type":"string"},{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"}]},"maxItems":16,"minItems":2,"type":"array"},"crossings":{"description":"Pedestrian crossings at these fractions of the road's length (0..1); makes the path a road.","items":{"type":"number"},"type":"array"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"jitter":{"type":"number"},"kerb":{"description":"Broken kerb stones here and there along the path's edges.","type":"boolean"},"layer":{"description":"under (default) = applied before the areas: paint/noise/path under are replaced wherever an area sets its floor (use under for outdoor ground and roads); a height op under sets the ground height that areas without floorHeight inherit. over = applied after the areas, on their floor (water or lava in a cave, a dais or pit inside a room).","enum":["under","over"],"type":"string"},"material":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"op":{"const":"path"},"points":{"items":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"minItems":2,"type":"array"},"seed":{"type":"integer"},"sidewalk":{"additionalProperties":false,"description":"Makes the path a road (straight, no jitter) with a raised pavement on both sides and kerbs between (kerb false turns them off).","properties":{"material":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"raise":{"description":"pavement height above the road, tiles (default 0.25)","type":"number"},"width":{"type":"integer"}},"required":["width","material"],"type":"object"},"style":{"description":"natural winds and varies in width (default for dirt, gravel, grass, sand, mud, snow, rock); straight for paved roads and corridors.","enum":["natural","straight"],"type":"string"},"width":{"type":"integer"}},"required":["id","op","width","material"],"type":"object"},{"additionalProperties":false,"properties":{"avoid":{"items":{"enum":["water","paths","areas","walls","features","links"],"type":"string"},"type":"array"},"density":{"description":"0..1","type":"number"},"exclude":{"items":{"$ref":"#/$defs/shape"},"maxItems":8,"type":"array"},"feature":{"enum":["table","round_table","chair","bench","stool","bed","bunk_bed","wardrobe","bookshelf","desk","chest","barrel","crate","sack","shelf","counter","bar_counter","throne","rug","cauldron","anvil","forge","weapon_rack","armor_stand","cage","stocks","pillar","statue","altar","fountain","well","brazier","torch_wall","candelabra","banner_wall","painting_wall","sarcophagus","coffin","tomb","bones","rubble","web","debris","pool","lever","trap","trap_plate","chandelier","tree","dead_tree","pine_tree","bush","rock","boulder","stump","log","mushroom","flowers","tall_grass","reeds","campfire","tent","cart","wagon","fence_post","signpost","standing_stone","grave","stalagmite","stalactite","rock_formation","cave_in","crystal","giant_mushroom","root","root_large","roots_wall","vines","tree_large","candles","skull_pile","spawn_point","torch_floor","lantern","magic_fire","lava_glow","fire_pit","monolith","cave_column","statue_large","mine_cart","rails","mine_support","chains","landmark","tall_marker","formation","cluster_tall","undergrowth","ground_cover","accent_light","edge_dressing","small_detail","wall_dressing","bank_dressing","jetty","vehicle","seating","signage","cliff_face","cliff_crest","stall","goods","overhead","line_post","clutter","shelf_line","custom"],"type":"string"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"minSpacing":{"type":"integer"},"op":{"const":"scatter"},"randomRotation":{"type":"boolean"},"seed":{"type":"integer"},"shape":{"$ref":"#/$defs/shape"},"variants":{"items":{"type":"string"},"type":"array"}},"required":["id","op","feature","density"],"type":"object"},{"additionalProperties":false,"properties":{"area":{"description":"area: optional on generator 2 — leave it out (or give the level id) to dress the whole level: the open ground and each zone.","type":"string"},"density":{"type":"number"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"op":{"const":"dress"},"preset":{"description":"Generator 4: a room preset (tavern to treasury in this list) furnishes and lights the room as that purpose, the way a room named for it is dressed by default (density 0.5 is the default amount); use one to choose the purpose or the amount.","enum":["tavern","library","barracks","bedroom","kitchen","storeroom","throne_room","shrine","crypt","prison","forge","laboratory","treasury","ruin","camp","ritual_circle","overgrown","cavern","collapse","crystal_grotto","campsite","shrine_ruin","bone_pit","mine_works","mushroom_grove","barricade","natural_clusters","woodland","forest","dense_forest","street","alley","plaza"],"type":"string"},"seed":{"type":"integer"}},"required":["id","op","preset"],"type":"object"},{"additionalProperties":false,"description":"A meandering trench cut into the floor of the areas it crosses (always applied after the areas): a chasm, crevasse, ravine or rift, and also a stream or river bed (floor water_shallow, depth 0.5..1) or a dry gully. Cliff sides, optional bridges across.","properties":{"bridges":{"items":{"additionalProperties":false,"properties":{"arch":{"description":"rise of the middle above the ends, tiles 0..2.","type":"number"},"at":{"description":"0..1 along the chasm (default 0.5).","type":"number"},"crumble":{"description":"0..0.6 fraction of the deck crumbled away (a way across always remains).","type":"number"},"floor":{"description":"Deck material (default flagstone).","enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"railing":{"description":"default low_wall; ruined suits an old bridge.","enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"span":{"description":"default arch (stone) or plank (wood floor).","enum":["arch","flat","plank","natural"],"type":"string"},"width":{"description":"1..4 cells (default 2).","type":"integer"}},"type":"object"},"maxItems":4,"type":"array"},"depth":{"description":"Tiles below the floor, 0.5..4, multiple of 0.25 (default 3).","type":"number"},"floor":{"description":"Bottom: lava, water_deep, water_shallow, rock… (default: keep the floor); none = bottomless.","enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete","none"],"type":"string"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"meander":{"description":"0..1 (default 0.5): how much the course and the banks wander.","type":"number"},"op":{"const":"chasm"},"points":{"description":"Course as cell centres, any direction; run it from wall to wall across the room.","items":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"maxItems":64,"minItems":2,"type":"array"},"seed":{"type":"integer"},"width":{"description":"Average width in cells, 1..12.","type":"number"}},"required":["id","op","points","width"],"type":"object"},{"additionalProperties":false,"description":"Tiered platform: dais, stepped pyramid, terrace, raised walkway, plateau; negative rise = sunken pit or amphitheatre. Rings each inset cells inside the one below and rise tiles higher. Cut into open floor (after the areas). Steps of 0.5 are walkable everywhere; stairs adds a flight on those sides.","properties":{"edge":{"description":"ragged = organic wandering contours (mounds, terraces, hills; default on open-air levels for natural materials); clean = crisp built tiers (daises).","enum":["ragged","clean"],"type":"string"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"inset":{"description":"Cells each tier steps in, 1..4 (default 1).","type":"integer"},"material":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"op":{"const":"platform"},"rise":{"description":"Tiles per tier, -2..2, not 0, multiple of 0.25 (default 0.5).","type":"number"},"shape":{"$ref":"#/$defs/shape"},"stairs":{"description":"Sides that get a 2-wide flight of steps to the top.","items":{"enum":["N","E","S","W"],"type":"string"},"maxItems":4,"type":"array"},"tiers":{"description":"1..5 (default 3).","type":"integer"},"topMaterial":{"enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"}},"required":["id","op","shape"],"type":"object"},{"additionalProperties":false,"description":"A straight flight of steps between two floor cells on one row or column, at any two heights (ledge to floor, into a dry chasm, up to a terrace or plateau). The cells between step evenly; every step is walkable.","properties":{"from":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"op":{"const":"stairs"},"style":{"description":"stairs (default): a flight of steps. ramp (generator 2): a rock ramp cut through a cliff, 3..6 cells wide, in any direction (a diagonal suits it), climbing at most 1 tile per 2.5 cells, so it needs a long run. An option for a natural slope where stairs would look built; whether minis walk it in game is not yet confirmed.","enum":["stairs","ramp"],"type":"string"},"to":{"description":"[x, y] cell coordinates (x east, y south).","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"width":{"description":"Stairs 1..3 (default 1); a ramp 3..6 (default 4).","maximum":6,"minimum":1,"type":"integer"}},"required":["id","op","from","to"],"type":"object"},{"additionalProperties":false,"description":"Uneven ground: gentle seeded bumps and hollows that stay walkable. Leave fighting space and paths out with exclude.","properties":{"amount":{"description":"Largest change in tiles, 0.25..1 (default 0.5).","type":"number"},"exclude":{"items":{"$ref":"#/$defs/shape"},"maxItems":8,"type":"array"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"op":{"const":"uneven"},"scale":{"description":"Bump size in cells, 3..12 (default 6).","type":"number"},"seed":{"type":"integer"},"shape":{"$ref":"#/$defs/shape"}},"required":["id","op"],"type":"object"},{"additionalProperties":false,"description":"Outcrop: a rock mass, column, crag or buttress rising out of the floor with cliff sides (any setting).","properties":{"height":{"description":"Tiles, 0.5..4 (default 2).","type":"number"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"material":{"description":"Top surface (default rock).","enum":["flagstone","stone_tile","marble","brick","cobble","wood_plank","carpet","rock","dirt","grass","sand","gravel","mud","snow","ice","swamp","water_shallow","water_deep","lava","bridge_wood","asphalt","concrete"],"type":"string"},"op":{"const":"outcrop"},"shape":{"$ref":"#/$defs/shape"}},"required":["id","op","shape"],"type":"object"},{"additionalProperties":false,"description":"Generator 3. An opening in the floor of this level so the level below shows through: a collapsed floor, a shaft, a gallery or balcony looking down into a hall. Put it inside a room of the upper level, over open floor of a room on the level below (stack the levels by elevation, one storey = 2.5). No wall is built round it (unlike an area with floor \\"none\\"): the edge gets a low railing or broken rim, a collapse gets a ragged outline and a heap of rubble on the floor below, and the build checks the cells beneath are open floor.","properties":{"edge":{"description":"Outline (default: ragged for a collapse, clean otherwise).","enum":["ragged","clean"],"type":"string"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"kind":{"description":"collapse (default): ragged hole, broken edge, rubble below. shaft: clean hole with a railing. balcony: like shaft, for a gallery over a room.","enum":["collapse","shaft","balcony"],"type":"string"},"op":{"const":"floor_opening"},"rim":{"description":"Edge piece. Generator 4 default: a collapse has none (broken rubble on the rim), a shaft a low_wall kerb, a balcony a railing; never ask for a 2-tall wall style, it hides the hole. Earlier generators: ruined for a collapse, iron_bars otherwise.","enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber","none"],"type":"string"},"rubble":{"description":"Collapse: heap rubble on the floor below (default true).","type":"boolean"},"shape":{"$ref":"#/$defs/shape"}},"required":["id","op","shape"],"type":"object"}]},"wallRun":{"additionalProperties":false,"properties":{"height":{"description":"Tiles (1 = 5 ft), multiple of 0.25.","type":"number"},"id":{"description":"Lowercase id, unique across the whole plan, e.g. \\"r1\\", \\"crypt_hall\\".","pattern":"^[a-z][a-z0-9_]{0,31}$","type":"string"},"op":{"enum":["add","remove"],"type":"string"},"points":{"items":{"description":"[x, y] grid VERTEX (corner) coordinates.","items":{"type":"integer"},"maxItems":2,"minItems":2,"type":"array"},"maxItems":64,"minItems":2,"type":"array"},"style":{"enum":["wall","stone","brick","wood","cave_rock","plaster","palisade","fence","hedge","low_wall","railing","iron_bars","ruined","railing_stone","concrete","metal","panel","marble","dark_stone","timber"],"type":"string"}},"required":["id","op","points"],"type":"object"}},"additionalProperties":false,"properties":{"baseVersion":{"type":"integer"},"changes":{"description":"≤ 6 short bullets describing what changed, naming rooms by key.","items":{"type":"string"},"maxItems":6,"type":"array"},"ops":{"items":{"$ref":"#/$defs/op"},"maxItems":100,"minItems":1,"type":"array"},"summary":{"description":"≤ 80 chars, becomes the version label.","type":"string"}},"required":["baseVersion","summary","changes","ops"],"type":"object"},"name":"edit_plan"}
{"description":"Look at the current plan. outline = every element with its key parameters (authoritative ids, compact); ascii = resolved map of one level (walls, doors, features, heights) optionally cropped to a region (a crop over 160×160 cells comes back as an overview, one character per block of cells with its scale stated: ask for a smaller region for every cell); json = exact JSON of selected elements. Call this before editing something you have not seen since the last change, or when the GM refers to a part of the map you need to inspect.","input_schema":{"additionalProperties":false,"properties":{"format":{"enum":["outline","ascii","json"],"type":"string"},"ids":{"items":{"type":"string"},"type":"array"},"level":{"type":"string"},"region":{"additionalProperties":false,"properties":{"h":{"type":"integer"},"w":{"type":"integer"},"x":{"type":"integer"},"y":{"type":"integer"}},"required":["x","y","w","h"],"type":"object"}},"required":["format"],"type":"object"},"name":"view_plan"}
{"description":"Render one level of the current plan as a PNG exactly as the GM sees it in the app. Use it sparingly — after creating a level or a large generated change — to check layout, proportions and overlaps that are hard to judge from ASCII.","input_schema":{"additionalProperties":false,"properties":{"level":{"type":"string"},"region":{"additionalProperties":false,"properties":{"h":{"type":"integer"},"w":{"type":"integer"},"x":{"type":"integer"},"y":{"type":"integer"}},"required":["x","y","w","h"],"type":"object"},"showIds":{"type":"boolean"}},"required":["level"],"type":"object"},"name":"view_map_image"}
{"description":"Look at what the build of the current version puts in TaleSpire, in 3D: one picture of up to 4 numbered views, a caption per view, and the faults measured on the real pieces in view (gaps in walls, floors and roofs, pieces floating, buried or running into each other, things facing a wall, ways too narrow to walk), each with its level, element and square. Pieces are flat colours by kind (wall, floor, roof, door or window, stairs, prop), not the game's look; a piece the app has not read from the game yet is a box of its real size. Only a few pictures are allowed per GM message, so ask for the views you need. Views: overview (the whole map), level:<level id> (that level from above, everything over it hidden), front:<id> (a building, structure or object from the side its doors face), interior:<id> (inside it, roofs and upper storeys hidden), flagged (where the last design review pointed), changed (what the last version changed). Leave shots out to let the app choose.","input_schema":{"additionalProperties":false,"properties":{"max":{"description":"At most this many views (default 4).","maximum":4,"minimum":1,"type":"integer"},"shots":{"items":{"description":"overview, flagged, changed, level:<level id>, front:<element id> or interior:<element id>.","pattern":"^(overview|flagged|changed|(level|front|interior):\\\\S+)$","type":"string"},"maxItems":4,"minItems":1,"type":"array"}},"required":[],"type":"object"},"name":"view_build_3d"}
{"description":"Estimate the TaleSpire build without exporting: asset count and slab chunk count per level, and anything that cannot be built with the current themes (missing assets, unsupported features). Call before telling the GM the map is ready to build, or when asked about size.","input_schema":{"additionalProperties":false,"properties":{"levels":{"items":{"type":"string"},"type":"array"}},"required":[],"type":"object"},"name":"compile_preview"}
{"description":"List what can be built: installed themes, materials, wall styles, dress presets, or feature types (with which ones the given theme has real TaleSpire assets for). Call when choosing a theme or before using a feature you are unsure the theme supports.","input_schema":{"additionalProperties":false,"properties":{"theme":{"type":"string"},"what":{"enum":["themes","features","materials","wall_styles","presets"],"type":"string"}},"required":["what"],"type":"object"},"name":"list_catalog"}"
`;

exports[`working tool list (tools-1.11.0; published versions are pinned by hash below) > serializes deterministically (the bytes are the cache key) 2`] = `"47a4d140f1b66ea7"`;
