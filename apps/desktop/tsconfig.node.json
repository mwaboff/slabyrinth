{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild/node",
    "emitDeclarationOnly": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "scripts/**/*.ts",
    "electron.vite.config.ts"
  ],
  "references": [{ "path": "../../packages/core" }, { "path": "../../packages/core/tsconfig.test.json" }]
}
