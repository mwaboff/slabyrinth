{
  "name": "@slabyrinth/desktop",
  "productName": "Slabyrinth",
  "version": "0.1.0",
  "private": true,
  "description": "Slabyrinth desktop app: design TaleSpire maps with Claude and export slabs.",
  "author": {
    "name": "Michael Aboff",
    "email": "michael@aboff.com"
  },
  "homepage": "https://slabyrinth.aboff.com/",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --root ../.. --project desktop-main --project desktop-renderer",
    "test:e2e": "electron-vite build --mode test && playwright test",
    "smoke:packaged": "tsx scripts/packaged-smoke.ts",
    "icons": "tsx scripts/make-placeholder-icons.ts",
    "package": "electron-vite build && electron-builder --dir --publish never",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "build:test": "electron-vite build --mode test",
    "capture:site": "electron-vite build --mode test && playwright test -c playwright.site.config.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.8",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  }
}
