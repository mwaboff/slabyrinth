{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild/e2e",
    "emitDeclarationOnly": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
