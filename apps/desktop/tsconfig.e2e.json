{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild/e2e",
    "emitDeclarationOnly": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": [
    "e2e/**/*.ts",
    "playwright.config.ts",
    "playwright.site.config.ts",
    "src/shared/**/*.ts",
    "src/main/agent/provider/types.ts",
    "src/main/logger.ts",
    "src/main/services/talespire/link/linkServer.ts",
    "src/main/services/talespire/link/hotkeys.ts",
    "src/main/services/talespire/link/protocol.ts",
    "src/main/services/talespire/link/wsLite.ts",
    "src/main/services/talespire/link/testing/*.ts",
    "src/renderer/bridge/fake/talespireLink.ts"
  ],
  "references": [{ "path": "../../packages/core" }]
}
